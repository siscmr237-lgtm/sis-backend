// Prisma schema for SIS using PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique @db.VarChar(16) // e.g., STU001
  school             School               @relation(fields: [schoolId], references: [id])
  schoolId           Int
  firstName          String
  lastName           String
  /// OPTIONAL. A school enrolling a child often does not have the birth
  /// certificate to hand on the day, and requiring it meant the student could
  /// not be entered at all until it turned up.
  ///
  /// NULL rather than a stand-in date: the create route used to fall back to
  /// "today", which stored a birthday that was silently wrong and then showed
  /// as fact on the profile. NULL reads as "not recorded", which is the truth,
  /// and the profile already renders a missing date as an em dash.
  dateOfBirth        DateTime?
  gender             String
  class              String
  /// OPTIONAL, both sides. A guardian's name and phone are often not available
  /// at the moment of enrolment, and a missing contact must not be what keeps a
  /// child off the roster.
  ///
  /// No link at all rather than a blank Parent row: Parent is deduped by
  /// @@unique([schoolId, name, phone]), so an empty name/phone pair would be one
  /// shared "nobody" record that every contactless student pointed at — and
  /// editing one child's guardian would then rewrite it for all of them. A NULL
  /// parentId says "no guardian on file" without inventing anyone.
  ///
  /// withFlatParent() in src/utils/parents.js already flattens a missing parent
  /// to empty parentName/parentPhone, so responses keep their existing shape.
  parent             Parent?              @relation(fields: [parentId], references: [id])
  parentId           Int?
  address            String
  enrollmentDate     DateTime
  allergies          String?
  medicalConditions  String?
  currentMedications String?
  medicalNotes       String?
  /// True when this student has been DETACHED from their class level's fee
  /// structure and billed from their own snapshot instead (scholarship, staff
  /// child, partial waiver). While set, feeOverrides below is the student's fee
  /// structure and the level sync skips them entirely, so a later class-level
  /// change does not silently undo the arrangement.
  ///
  /// A flag rather than "has override rows", because an override can legitimately
  /// be an EMPTY set — a student who owes nothing at all — which is a different
  /// thing from not being overridden.
  feesOverridden     Boolean              @default(false)
  feeOverrides       StudentFeeOverride[]
  ledgerEntries      LedgerEntry[]
  pickupContacts     PickupContact[]
  marks              StudentMark[]

  /// WHO ENROLLED THIS STUDENT. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("StudentCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  @@index([schoolId])
  @@index([schoolId, class])
  @@index([parentId])
  @@index([createdByAdminId])
}

// A parent/guardian contact, shared across however many of their children are
// enrolled — editing this record (e.g. a corrected phone number) is visible
// to every linked Student. Deliberately dedupes only on an exact (schoolId,
// name, phone) match, never fuzzy — near-identical entries stay separate.
model Parent {
  id       Int       @id @default(autoincrement())
  school   School    @relation(fields: [schoolId], references: [id])
  schoolId Int
  name     String
  phone    String
  students Student[]

  @@unique([schoolId, name, phone])
  @@index([schoolId])
}

model PickupContact {
  id           Int      @id @default(autoincrement())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    Int
  name         String
  phone        String
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
}

model Staff {
  id                    Int                   @id @default(autoincrement())
  code                  String                @unique @db.VarChar(16) // e.g., STF001
  school                School                @relation(fields: [schoolId], references: [id])
  schoolId              Int
  firstName             String
  lastName              String
  /// OPTIONAL, and nullable rather than defaulting to '': it sits under
  /// @@unique([schoolId, idNumber]) below, where two empty strings would collide
  /// and the second staff member without an ID would be refused. NULLs are
  /// distinct in a unique index, so any number of rows may have none.
  idNumber              String?
  role                  String
  phone                 String
  // Scoped per school by the @@unique below, NOT globally: schools are separate
  // tenants, so one school having a staff member on an address must never stop
  // another school entering the same person — nor reveal, via a uniqueness
  // error, that the address exists somewhere else in the system.
  /// OPTIONAL — see idNumber above for why this is nullable and not ''. A staff
  /// member with no email simply has no way to be invited to log in:
  /// POST /staff/:id/invite already refuses when it is missing, and teacher
  /// sign-in looks accounts up BY email, so a NULL one matches nothing.
  email                 String?
  hireDate              DateTime
  salary                Int
  isTeacher             Boolean               @default(false)
  /// Set once a staff member has been given self-service login. NULL is the
  /// normal state for a newly created record and means "cannot log in yet" —
  /// not "locked out": every Staff row predates teacher login, so a nullable
  /// column is what lets existing staff keep working untouched while an admin
  /// issues credentials one at a time. Never compare a supplied password
  /// against a NULL hash; treat NULL as "no login" before any bcrypt call.
  passwordHash          String?
  /// Whether this staff member may log in at all, independent of whether they
  /// HAVE a password. Lets an admin revoke access — a teacher on suspension, or
  /// one who has left — without deleting the Staff row, which would take their
  /// work records, class assignments and ledger history with it.
  isActive              Boolean               @default(true)
  workRecords           WorkRecord[]
  classesAsClassTeacher Class[]               @relation("ClassTeacher")
  subjectAssignments    ClassSubjectTeacher[]
  ledgerEntries         LedgerEntry[]

  /// WHO ADDED THIS STAFF MEMBER. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("StaffCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  // All three are scoped per school, never globally: the same person can
  // legitimately be on staff at more than one school, so one school holding
  // their email, phone or ID must not block another from entering them — nor
  // reveal, through a uniqueness error, that the value exists elsewhere.
  // Within a single school each stays unique.
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@unique([schoolId, idNumber])
  @@index([schoolId])
  @@index([createdByAdminId])
}

model Expense {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(16) // e.g., EXP001
  school        School   @relation(fields: [schoolId], references: [id])
  schoolId      Int
  date          DateTime
  category      String
  description   String
  amount        Int
  payee         String
  paymentMethod String
  // Per school, not global. Invoice numbers are each school's own document
  // series, so sequences like "INV-001" collide across tenants almost by
  // definition — a global constraint both blocks legitimate entry and leaks
  // that another school already used the number.
  invoiceNumber String

  /// WHO RECORDED THIS EXPENSE. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("ExpenseCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, date])
  @@index([createdByAdminId])
}

model AttendanceRecord {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(16) // e.g., ATT001
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   Int
  date       DateTime
  type       String
  personId   String
  personName String
  status     String
  remarks    String?

  /// WHO TOOK THIS REGISTER. Nullable on both counts, and for two different
  /// reasons. A teacher may mark attendance (POST /attendance/mark and /bulk),
  /// and a teacher is not an AdminUser — so the id stays NULL while the name
  /// records who it actually was. Every row written before this feature has
  /// neither, which reads as "not recorded" rather than as anybody.
  createdBy        AdminUser? @relation("AttendanceRecordCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  /// One record per person per DAY. Attendance is a yes/no fact about a date, so
  /// a second row for the same person and day is never a second fact — it is a
  /// duplicate that double-counts in every percentage derived from it, including
  /// the term consistency figure the report card consumes.
  ///
  /// `date` is normalised to midnight UTC on write (see src/utils/attendanceDay.js);
  /// without that this index would key on the timestamp and happily admit two
  /// rows for the same calendar day.
  @@unique([schoolId, type, personId, date])
  @@index([schoolId, date])
  @@index([schoolId, personId])
  @@index([createdByAdminId])
}

model WorkRecord {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(16) // e.g., WR001
  staff      Staff    @relation(fields: [staffId], references: [id])
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   Int
  staffId    Int
  staffName  String
  date       DateTime
  subject    String
  class      String
  topic      String
  objectives String
  activities String
  evaluation String
  remarks    String?

  /// WHO WROTE THIS RECORD UP. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("WorkRecordCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  @@index([schoolId])
  @@index([staffId, schoolId])
  @@index([createdByAdminId])
}

model ReportCard {
  id                 Int    @id @default(autoincrement())
  code               String @unique @db.VarChar(16) // e.g., RC001
  school             School @relation(fields: [schoolId], references: [id])
  schoolId           Int
  studentId          String
  studentName        String
  class              String
  term               String
  academicYear       String
  subjects           Json
  averageScore       Int
  position           Int
  totalStudents      Int
  attendance         Int
  headTeacherComment String

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([schoolId, term, academicYear])
}

model TimetableEntry {
  id       Int    @id @default(autoincrement())
  code     String @unique @db.VarChar(16) // e.g., TT001
  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int
  day      String
  time     String
  class    String
  subject  String
  teacher  String

  @@index([schoolId])
  @@index([schoolId, class])
}

model Class {
  id              Int                   @id @default(autoincrement())
  code            String                @unique @db.VarChar(16)
  name            String
  school          School                @relation(fields: [schoolId], references: [id])
  schoolId        Int
  classTeacher    Staff?                @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  classTeacherId  Int?
  subjectTeachers ClassSubjectTeacher[]
  testExams       TestExam[]

  @@unique([name, schoolId])
}

model Subject {
  id                 Int                    @id @default(autoincrement())
  name               String
  school             School                 @relation(fields: [schoolId], references: [id])
  schoolId           Int
  classLevelSubjects ClassLevelSubject[]
  subjectTeachers    ClassSubjectTeacher[]
  subjectTotals      TestExamSubjectTotal[]
  marks              StudentMark[]

  @@unique([name, schoolId])
}

/// Which subjects a class LEVEL teaches — "Class 1", "Nursery 1" — shared by
/// every section of it. This replaced a per-Class (per-SECTION) link: sections of
/// one level are the same grade taught twice, so giving them independent subject
/// lists let them silently diverge, and the admin had to repeat every change per
/// section.
///
/// Mirrors ClassLevelFee exactly, including storing the level as a string rather
/// than pointing at a Class row: the level is a concept above the Class table
/// (several sections map to one level, and a level can be configured before any
/// section of it exists). src/utils/classLevels.js is the only place a level is
/// derived from a class name.
model ClassLevelSubject {
  id         Int     @id @default(autoincrement())
  school     School  @relation(fields: [schoolId], references: [id])
  schoolId   Int
  classLevel String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  Int

  @@unique([schoolId, classLevel, subjectId])
  @@index([schoolId, classLevel])
}

model ClassSubjectTeacher {
  id        Int     @id @default(autoincrement())
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   Int
  staff     Staff   @relation(fields: [staffId], references: [id])
  staffId   Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int

  @@unique([classId, staffId, subjectId])
}

enum TestExamType {
  TEST
  EXAM
}

// A single test/exam instance (e.g. "CA1", "End of Term Exam"), always scoped
// to exactly one class — never shared or reused across classes, even when two
// classes teach the same subject under the same name.
model TestExam {
  id                    Int                    @id @default(autoincrement())
  school                School                 @relation(fields: [schoolId], references: [id])
  schoolId              Int
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId               Int
  academicYear          String
  term                  String
  name                  String
  type                  TestExamType
  order                 Int                    @default(0)
  subjectTotals         TestExamSubjectTotal[]
  studentMarks          StudentMark[]
  // Set once the term this assessment belongs to has ended and every still-
  // unmarked student has been given a 0 (see src/utils/termEndZeros.js). This
  // is what makes the sweep idempotent: an assessment is only ever processed
  // while this is null, so a second run cannot re-zero a mark a teacher has
  // since edited. Left null on assessments created after their term ended
  // until the next sweep picks them up.
  termEndZerosAppliedAt DateTime?
  // When this assessment was first WRITTEN — the moment any student in its class
  // first had a mark recorded for it, in any subject. Set once and never
  // cleared: a partly-graded test cannot become un-written, so deleting every
  // mark afterwards does not undo it.
  //
  // Distinct from termEndZerosAppliedAt, which is about the calendar. This is
  // about the test actually having been sat, and it is what licenses the
  // save-time zero fill in the bulk marks endpoint: once a paper has been
  // written, a student with no score did not miss the marking, they scored zero.
  activatedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([classId, academicYear, term, name])
  @@index([schoolId])
  @@index([classId, academicYear, term])
  // Drives the sweep's "anything left to zero?" lookup, which runs on ordinary
  // reads and must stay cheap when the answer is no.
  @@index([schoolId, termEndZerosAppliedAt])
}

// The school-configured total marks for one subject on one test/exam. Set
// manually per subject per test/exam, so totals can differ both across
// tests/exams and across subjects within the same test/exam.
model TestExamSubjectTotal {
  id         Int      @id @default(autoincrement())
  testExam   TestExam @relation(fields: [testExamId], references: [id], onDelete: Cascade)
  testExamId Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  Int
  totalMarks Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([testExamId, subjectId])
}

// A student's score for one subject on one test/exam. Can only be created
// once the matching TestExamSubjectTotal exists; marksObtained is enforced
// (at the application layer) to never exceed that configured total.
//
// Three states, and the absence of a row is one of them:
//   MARKED   — a row with isExempt = false and a number in marksObtained. A 0
//              here is a real score of zero, whether a teacher typed it or the
//              term-end sweep filled it in; nothing distinguishes the two,
//              because for every purpose a zero is just a zero.
//   EXEMPT   — a row with isExempt = true and marksObtained NULL. Excluded from
//              the student's score AND their denominator: never a zero, never
//              counted. Reversible.
//   UNMARKED — NO ROW. Excluded from the denominator during the term, then
//              converted to a marked 0 once the term ends.
//
// A CHECK constraint (see the accompanying migration) enforces that exactly one
// of isExempt/marksObtained is set, so a row can never be both at once or
// neither — a state no application path produces but which would silently
// corrupt every total if it ever appeared.
model StudentMark {
  id            Int      @id @default(autoincrement())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     Int
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId     Int
  testExam      TestExam @relation(fields: [testExamId], references: [id], onDelete: Cascade)
  testExamId    Int
  marksObtained Int?
  isExempt      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, subjectId, testExamId])
  @@index([testExamId])
  @@index([subjectId])
  @@index([studentId])
}

enum SchoolType {
  DAYCARE_NURSERY
  DAYCARE_NURSERY_PRIMARY
}

/// Where a school stands in signing up, as ONE column rather than a set of
/// booleans that can disagree with each other. The four values are a strict
/// progression and a school occupies exactly one of them at a time:
///
///   FAILED     — signed up, email not verified. The account exists but has
///                proved nothing about itself yet.
///   INCOMPLETE — email verified, KYC not submitted.
///   PENDING    — KYC submitted, awaiting a decision from the platform team.
///   APPROVED   — approved. This is the ONLY value that opens the dashboard.
///
/// There is deliberately no REJECTED value. A school the team is not happy with
/// is left PENDING and sends itself back with "Not Done", which returns it to
/// INCOMPLETE to re-submit — so a refusal is never a dead end the school cannot
/// act on, and there is no state the product has no screen for.
enum RegistrationStatus {
  FAILED
  INCOMPLETE
  PENDING
  APPROVED
}

/// The proprietor's gender, and the only thing it decides: the honorific in
/// front of their initials on generated correspondence — "Mme" for FEMALE,
/// "Sir" for MALE. See feeDriveSignature in src/utils/proprietor.js.
///
/// NULL (the column is optional) means nobody has said yet, and that is a
/// third state rather than a missing one: the signature drops the honorific and
/// prints the bare initials instead of putting a title on a letter that no one
/// chose, over a named person's initials.
enum ProprietorGender {
  MALE
  FEMALE
}

model School {
  id                        Int                  @id @default(autoincrement())
  name                      String
  abbreviation              String
  abbreviationAutoGenerated Boolean              @default(true)
  logo                      String
  /// The school's ACTIVE academic year, "2026/2027" (a Sept–June window). This is
  /// now the single source of truth for the year: it is advanced by
  /// advanceYearIfDue (manual button, Aug nudge, Sept auto-advance) and is NEVER
  /// recomputed from today's date. Terms still cycle automatically by date within
  /// it — only the YEAR follows the manual → nudge → auto flow.
  academicYear              String
  /// The earliest year this school could have data for, derived from its signup
  /// date (the owning AdminUser's createdAt) rather than any user-entered field.
  /// Stored once so the year dropdown's lower bound is stable and cheap to read.
  firstAcademicYear         String?
  /// Set to the destination year when the year advanced AUTOMATICALLY, and cleared
  /// when the school acknowledges it. Its presence is what drives the one-time
  /// dismissible "Your academic year has changed to …" notice; a manual advance
  /// leaves it null, since the admin already knows.
  autoAdvancedYear          String?
  currentTerm               String
  autoTermEnabled           Boolean              @default(true)
  motto                     String?
  /// Only ever read to build the honorific on a Fee Drive letter — see the
  /// ProprietorGender enum above. The proprietor's NAME is deliberately not
  /// duplicated here: it is adminUser.name, the account that owns this school,
  /// and a copy would be a second answer to "who is the proprietor?" that
  /// nothing keeps in step with the first.
  proprietorGender          ProprietorGender?
  address                   String?
  schoolType                SchoolType?
  uniformColors             Json                 @default("{\"shirt\":null,\"trouser\":null,\"gown\":null}")
  onboardingCompleted       Boolean              @default(true)
  /// The approval gate. Read LIVE from this column on every authenticated
  /// request (loadAdminActor includes School), never from a claim inside the
  /// session token — approval is granted while a token is still valid, so a
  /// cached copy would leave an approved school locked out, and an unapproved
  /// one let in, for the rest of its idle window.
  ///
  /// Kept alongside onboardingCompleted rather than replacing it: that flag
  /// still answers "has KYC been submitted?", which the setup wizard and the
  /// dashboard checklist both depend on. PENDING and APPROVED both imply
  /// onboardingCompleted = true; this column adds what happened after.
  registrationStatus        RegistrationStatus   @default(INCOMPLETE)
  /// When the admin last left the post-KYC setup wizard, by finishing it or by
  /// skipping out of it. NULL means they have never been through it, which is
  /// the only thing that makes the wizard appear.
  ///
  /// This is NOT progress tracking. It records that the wizard was SEEN and
  /// nothing about what was set up: every step's done/not-done is still read
  /// live from the tables, by the same code the dashboard checklist uses.
  /// Skipping a step leaves no trace anywhere — it simply has no data, so the
  /// checklist lists it as outstanding. The two are one system: the wizard
  /// guides once, the checklist catches whatever was skipped, and they cannot
  /// disagree because neither stores an opinion about completeness.
  ///
  /// A timestamp rather than a boolean so it is possible to tell WHEN a school
  /// dismissed it; a bare `true` says nothing useful a month later.
  setupWizardCompletedAt    DateTime?
  subjectsPerClass          Json
  /// THE OWNER. Named because there are now two relations between School and
  /// AdminUser and Prisma disambiguates them by name; naming an explicit
  /// fields/references relation changes no SQL — the column and the constraint
  /// keep the names they already have.
  adminUser                 AdminUser            @relation("SchoolOwner", fields: [adminUserId], references: [id])
  adminUserId               Int
  /// The ADMINISTRATOR accounts the owner has invited into this school. They do
  /// not own it — adminUserId above is still the single owning account — so this
  /// is the only thing that scopes them to a school at all. See loadAdminActor.
  admins                    AdminUser[]          @relation("SchoolAdmins")
  Student                   Student[]
  Parent                    Parent[]
  Staff                     Staff[]
  Expense                   Expense[]
  AttendanceRecord          AttendanceRecord[]
  WorkRecord                WorkRecord[]
  ReportCard                ReportCard[]
  TimetableEntry            TimetableEntry[]
  Class                     Class[]
  Subject                   Subject[]
  chargeCategories          ChargeCategory[]
  classLevelFees            ClassLevelFee[]
  classLevelNoFees          ClassLevelNoFees[]
  classLevelSubjects        ClassLevelSubject[]
  studentFeeOverrides       StudentFeeOverride[]
  ledgerEntries             LedgerEntry[]
  TestExam                  TestExam[]
}

model ChargeCategory {
  id        Int           @id @default(autoincrement())
  name      String
  limit     Int           @default(0)
  isBuiltIn Boolean       @default(false)
  forStaff  Boolean       @default(false)
  /// WHICH WAY the money runs, for staff categories only.
  ///
  /// The staff ledger already had a direction baked into it: a CHARGE meant the
  /// SCHOOL owed the staff member (salary accrued, a bonus due, an allowance)
  /// and a PAYMENT meant the school had paid them, so balance = charged - paid
  /// was "what we still owe this person".
  ///
  /// Staff FINES run the other way — a broken window or a late-coming penalty is
  /// money the staff member owes the SCHOOL. Stored as a plain CHARGE it would
  /// have increased what the school appears to owe them, which is precisely
  /// backwards, so the direction is marked on the category instead.
  ///
  /// Defaults false, which is what makes this migration a no-op: every category
  /// that already exists (Salary, Bonus, Damage, Staff Expense, Transportation
  /// Allowance) keeps its original meaning untouched.
  staffOwes Boolean       @default(false)
  school    School        @relation(fields: [schoolId], references: [id])
  schoolId  Int
  entries   LedgerEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([name, schoolId])
}

/// A fee belonging to a class LEVEL — "Class 1", "Nursery 1" — never to a
/// section and never to the school. Every section of a level ("Class 1 A",
/// "Class 1 B") shares one fee structure, which is why classLevel stores the
/// level name rather than pointing at a Class row: a section is not the owner,
/// and adding or removing sections must not disturb the fees.
///
/// classLevel is a plain string rather than an FK because the level is a
/// concept above the Class table (several Class rows map to one level, and a
/// level can be configured before any section of it exists). src/utils/
/// classLevels.js is the only place that derives a level from a class name.
model ClassLevelFee {
  id                      Int           @id @default(autoincrement())
  school                  School        @relation(fields: [schoolId], references: [id])
  schoolId                Int
  classLevel              String
  name                    String
  /// What every student of this level is charged for this fee. 0 is a real,
  /// valid value: the defaults are seeded with no amount so a school fills in
  /// its own, and a guessed figure would look authoritative.
  amount                  Int           @default(0)
  /// How much of `amount` must be paid for this fee to count as part of the
  /// first installment — an absolute figure, not a share. NULL means the
  /// category asks nothing upfront: it is met automatically and contributes
  /// zero to the required total, so the level's whole first-installment rule
  /// is "every fee where this is non-null and above 0".
  ///
  /// Never above `amount`. Enforced on every write rather than only in the
  /// dialog, because a requirement larger than the bill is unmeetable — the
  /// student could pay the fee in full and still read as short.
  /// clampFirstInstallmentAmount is the one place that clamp lives.
  firstInstallmentAmount  Float?
  /// Which fixed group this fee belongs to. REGISTRATION is structurally
  /// outside the first-installment rule — see computeStudentFeesStatus, which
  /// drops these fees from the rule whatever firstInstallmentAmount says on
  /// them. OTHER_FEES is the default and covers everything else.
  group                   FeeGroup      @default(OTHER_FEES)
  charges                 LedgerEntry[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([schoolId, classLevel, name])
  @@index([schoolId, classLevel])
}

/// A class level the school has declared it charges NOTHING for.
///
/// Needed because "this level has no fees" and "nobody has set this level's fees
/// up yet" look identical in the data, and the setup checklist has to tell them
/// apart — otherwise a school with a free nursery can never finish the fees step
/// and the card nags forever. A row here is an explicit statement, not an
/// absence.
///
/// A LEVEL, not a class, matching ClassLevelFee: fees belong to the level and
/// every section shares one structure, so the declaration has to sit at the same
/// grain or the two could disagree about a single section.
///
/// The invariant this must never break: a level cannot be both free and charged.
/// Saving any fee with an amount above 0 deletes the row (see PUT
/// /classes/levels/:level/fees), and levelFeeSetupStatus ignores the row anyway
/// whenever the level has a charged fee, so even a stale row cannot produce the
/// contradiction.
model ClassLevelNoFees {
  id         Int      @id @default(autoincrement())
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   Int
  classLevel String
  /// When it was declared free. A timestamp rather than a bare flag so the
  /// answer to "when did they decide this?" survives.
  markedAt   DateTime @default(now())

  @@unique([schoolId, classLevel])
  @@index([schoolId])
}

/// One fee in a single student's PERSONAL fee structure, used when they have been
/// detached from their class level's (Student.feesOverridden).
///
/// A snapshot, not a diff against the level: the dialog pre-fills it from the
/// level's current fees and the admin adjusts down, so from then on the student's
/// bill is fully described here. Storing deltas instead would mean the meaning of
/// a waiver silently changed whenever the class fee moved, which is exactly what
/// detaching is meant to prevent.
model StudentFeeOverride {
  id                      Int           @id @default(autoincrement())
  school                  School        @relation(fields: [schoolId], references: [id])
  schoolId                Int
  student                 Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId               Int
  name                    String
  amount                  Int           @default(0)
  /// Same meaning as on ClassLevelFee: an absolute amount, NULL meaning this
  /// category asks nothing upfront and is met automatically. Never above
  /// `amount`.
  firstInstallmentAmount  Float?
  /// Which fixed group this fee belongs to. REGISTRATION is structurally
  /// outside the first-installment rule — see computeStudentFeesStatus, which
  /// drops these fees from the rule whatever firstInstallmentAmount says on
  /// them. OTHER_FEES is the default and covers everything else.
  group                   FeeGroup      @default(OTHER_FEES)
  charges                 LedgerEntry[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([studentId, name])
  @@index([schoolId])
}

/// Which of the two fixed groups a fee category belongs to.
///
/// Exactly two, deliberately closed. A school cannot add a third, rename these,
/// or configure them: the whole point is that REGISTRATION means the same thing
/// in every school, because the first-installment rule is defined in terms of
/// it. A school-nameable group would make that rule mean whatever each school
/// happened to type.
///
/// An enum rather than a string so the database refuses anything else — a typo
/// in a group name would silently move a fee out of Registration and quietly
/// change who has met their first installment.
enum FeeGroup {
  REGISTRATION
  OTHER_FEES
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
}

model LedgerEntry {
  id                   Int                 @id @default(autoincrement())
  code                 String              @unique @db.VarChar(16)
  type                 LedgerEntryType
  school               School              @relation(fields: [schoolId], references: [id])
  schoolId             Int
  student              Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId            Int?
  staff                Staff?              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId              Int?
  category             ChargeCategory?     @relation(fields: [categoryId], references: [id])
  categoryId           Int?
  /// Set on the one CHARGE row that bills a student for a class-level fee.
  /// Exactly one such row exists per (student, fee) — see the compound unique
  /// below — so when a level's amount changes that row is updated in place and
  /// the student's total charged always equals the level's current fee
  /// structure. That is what makes a fee change apply to EXISTING charges
  /// rather than only future ones.
  classLevelFee        ClassLevelFee?      @relation(fields: [classLevelFeeId], references: [id], onDelete: Cascade)
  classLevelFeeId      Int?
  /// True only on the row that bills the class level's fee STRUCTURE — the one
  /// syncLevelFeeCharges owns and rewrites when the level's amount changes.
  ///
  /// An admin can also record an EXTRA charge against the same fee category
  /// (say a second Tuition charge). Those carry classLevelFeeId too, so they
  /// count toward that category's first-installment maths exactly like the
  /// billed charge, but isFeeStructureCharge is false so the level sync leaves
  /// them alone instead of overwriting them with the structural amount.
  ///
  /// A partial unique index — (studentId, classLevelFeeId) WHERE
  /// isFeeStructureCharge — keeps exactly one structural row per student per
  /// fee while allowing any number of extra charges. It is created in raw SQL
  /// in the migration because Prisma cannot express a partial index.
  isFeeStructureCharge Boolean             @default(false)
  /// The override fee this charge bills, for a DETACHED student. Exactly one of
  /// classLevelFeeId / studentFeeOverrideId is set on a fee-linked charge: the
  /// first while a student follows their class, the second once they have their
  /// own structure. Both null means a one-off charge, outside any fee structure.
  studentFeeOverride   StudentFeeOverride? @relation(fields: [studentFeeOverrideId], references: [id], onDelete: Cascade)
  studentFeeOverrideId Int?
  /// The short label shown wherever this entry is listed — for a charge raised by
  /// hand this is its NAME ("Broken window", "Trip"). Required, and long-standing.
  description          String
  /// The longer reason behind a charge, beyond that label. Nullable because
  /// nothing that already exists has one and most entries never need one; the
  /// charge form offers it as an optional third field.
  note                 String?
  /// For a PAYMENT, the specific CHARGE it settles.
  ///
  /// This is what makes a standalone charge — a fine, a replaced book — payable
  /// on its own. Fee-structure money is tied to a ClassLevelFee or a
  /// StudentFeeOverride, but a one-off charge belongs to no structure, so before
  /// this there was no way to say "this money settled that fine" and such charges
  /// could only be cleared by an untagged payment.
  ///
  /// Deliberately NOT modelled as a StudentFeeOverride: that would flip
  /// feesOverridden and silently convert the student to custom fees, when a fine
  /// has nothing to do with their fee structure.
  ///
  /// ON DELETE SET NULL, never cascade: deleting a charge must not delete the
  /// money someone actually handed over. The payment survives, untagged.
  settles              LedgerEntry?        @relation("EntrySettlement", fields: [settlesEntryId], references: [id], onDelete: SetNull)
  settlesEntryId       Int?
  settledBy            LedgerEntry[]       @relation("EntrySettlement")
  /// The month this PAYMENT is the payroll run for, as an absolute "2026-09".
  ///
  /// Set ONLY on the one row that pays a staff member for a month, which is what
  /// makes the unique index below mean "a month can be paid at most once". The
  /// key is absolute rather than a bare month name so it can never be ambiguous
  /// about which September it refers to; the academic year a month belongs to is
  /// derived from it, not stored twice.
  ///
  /// Null on everything else — every charge, every student row, and the
  /// settlement rows a payroll run creates. Postgres treats NULLs as distinct in
  /// a unique index, so those rows are unconstrained.
  payrollMonth         String?
  /// The BONUS portion of a payroll run's `amount`, so the salary portion is
  /// `amount - payrollBonus`. Held as a split of one row rather than a second
  /// row because the two are one event: the cap applies to the salary portion
  /// alone (a bonus is on top and is never capped), and deleting the payroll
  /// must not be able to leave a bonus behind with nothing to belong to.
  /// The reason for the bonus goes in `note`.
  payrollBonus         Int?
  amount               Int
  entryDate            DateTime
  paymentMethod        String?
  academicYear         String
  term                 String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  /// WHO RECORDED THIS ENTRY. NULL on both columns for the fee-structure rows
  /// syncLevelFeeCharges writes: nobody records those by hand, so attributing
  /// them to whoever happened to trigger the sync would name the wrong person.
  /// See isFeeStructureCharge above and the note on AdminUser.role.
  createdBy        AdminUser? @relation("LedgerEntryCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  /// A staff member's month can be paid at most once, enforced by the database
  /// rather than by a check-then-insert that two admins could race through.
  /// Only payroll rows carry a payrollMonth, and NULLs are distinct in Postgres,
  /// so this constrains nothing else.
  @@unique([staffId, payrollMonth])
  @@index([studentId, schoolId])
  @@index([staffId, schoolId])
  @@index([schoolId])
  @@index([schoolId, academicYear, term])
  @@index([classLevelFeeId])
  @@index([studentFeeOverrideId])
  /// Drives "how much of this charge has been settled?", which the owing endpoint
  /// asks per standalone charge.
  @@index([settlesEntryId])
  @@index([createdByAdminId])
}

/// Who an account is INSIDE ONE SCHOOL. Nothing to do with PlatformRole, which
/// is a role on the internal team — the two enums live on different tables and
/// must never be compared or substituted for one another. Nor with Staff.role,
/// which is a free-text job title.
enum AdminRole {
  /// The account created at signup, which owns the School row. It may do
  /// anything: edit or delete any record whoever made it, and invite and remove
  /// Administrators.
  OWNER
  /// An account the Owner invited. It does the day-to-day work but may only
  /// edit what it created itself, may delete nothing, and cannot see the
  /// Administrators section at all. Enforced in the API, not by hiding buttons.
  ADMINISTRATOR
}

model AdminUser {
  id               Int       @id @default(autoincrement())
  /// OPTIONAL since Administrator invites. An Owner always has one — signup
  /// asks for it — but an invite carries a name and an email and nothing else,
  /// so an invited account has no number until it chooses to add one. NULLs are
  /// distinct in a unique index, so any number of accounts may have none.
  phoneNumber      String?   @unique
  email            String?   @unique
  /// OPTIONAL for the same reason, and it carries the same meaning it does on
  /// Staff: NULL is "cannot log in yet", never "locked out". An invited
  /// Administrator has none until they follow their emailed link and choose a
  /// password. NEVER compare a supplied password against a NULL hash — treat
  /// NULL as no-login before any bcrypt call, which is what POST /auth/login does.
  passwordHash     String?
  name             String
  /// WAS a free-text String defaulting to "admin", written at signup and read by
  /// nothing. It is now the enum above, and OWNER is the default precisely so
  /// that every account that existed before this — all of which were the school
  /// signup account — keeps every power it had.
  role             AdminRole @default(OWNER)
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// The school this account OWNS. An array only because the relation is
  /// modelled from School.adminUserId; in practice it holds one row for an
  /// OWNER and none at all for an ADMINISTRATOR.
  School           School[]  @relation("SchoolOwner")
  /// The school this account is a MEMBER of, which is how an ADMINISTRATOR is
  /// scoped. Set on exactly the accounts School above is empty for. An OWNER
  /// leaves it NULL and is scoped by the school it owns instead — see
  /// loadAdminActor in src/auth.js, which accepts either and refuses a session
  /// that has neither rather than letting a query run unscoped.
  memberOfSchool   School?   @relation("SchoolAdmins", fields: [memberOfSchoolId], references: [id])
  memberOfSchoolId Int?

  passwordResetTokens PasswordResetToken[]

  /// Everything this account has created. Present so Prisma can express the
  /// other side of each createdBy; nothing reads these arrays — attribution is
  /// read off the record, from createdByName, not by walking back from here.
  createdStudents   Student[]          @relation("StudentCreatedBy")
  createdStaff      Staff[]            @relation("StaffCreatedBy")
  createdLedger     LedgerEntry[]      @relation("LedgerEntryCreatedBy")
  createdAttendance AttendanceRecord[] @relation("AttendanceRecordCreatedBy")
  createdWork       WorkRecord[]       @relation("WorkRecordCreatedBy")
  createdExpenses   Expense[]          @relation("ExpenseCreatedBy")

  @@index([memberOfSchoolId])
}

/// Who a platform account is on the INTERNAL team. Nothing to do with
/// AdminUser.role, which is a role inside one school — these two role systems
/// must never be compared or substituted for one another.
enum PlatformRole {
  /// May manage team accounts. The last remaining Founder cannot be deleted or
  /// demoted; that is enforced in src/routes/platform.js, not by hiding a button.
  FOUNDER
  /// Uses the console. Cannot see or reach the Administrators section at all.
  MEMBER
}

/// An internal team account. Deliberately a SEPARATE TABLE from AdminUser, not a
/// role on it: a platform session must never be loadable by the school session
/// path, and keeping the subjects in different tables means a token naming id 3
/// cannot resolve to a school admin just because the actorType claim was wrong.
///
/// There is no signup route for this table anywhere. Rows are created by the
/// untracked founder seed script, and thereafter by a Founder from the console.
model PlatformUser {
  id           Int          @id @default(autoincrement())
  name         String
  phoneNumber  String       @unique
  email        String       @unique
  passwordHash String
  role         PlatformRole @default(MEMBER)
  /// Disabling is preferred over deleting so the audit trail keeps pointing at a
  /// real row. A disabled account cannot authenticate.
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// Failed-login throttling, kept on the row rather than in memory: the API runs
  /// as serverless functions, so a per-process counter would reset on every cold
  /// start and protect nothing.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  auditEntries PlatformAuditLog[]
}

/// Every consequential thing a platform user does, written from the start rather
/// than added after something goes wrong. This table is append-only by
/// convention: no route updates or deletes a row.
model PlatformAuditLog {
  id        Int      @id @default(autoincrement())
  /// Null only for a failed login, where there may be no identifiable account.
  actorId   Int?
  actor     PlatformUser? @relation(fields: [actorId], references: [id])
  /// The email that was used, kept verbatim so a failed login against a
  /// non-existent account is still attributable to an attempt.
  actorEmail String?
  action    String
  /// What was acted on: "platform_user:4", "school:2", or null for a plain read.
  target    String?
  /// Small JSON blob of extra context. Never contains a password or a hash.
  detail    Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum OtpPurpose {
  /// The signup email check behind /school/verify-email. The only purpose any
  /// live code path writes or reads.
  SIGNUP_VERIFICATION
  /// Retained for the rows that already exist, NOT for new writes: password
  /// reset moved to PasswordResetToken and nothing issues one of these any more.
  /// Kept rather than dropped because a Postgres enum value cannot be removed
  /// while historical rows still reference it, and deleting those rows to tidy
  /// an enum is not a trade worth making.
  PASSWORD_RESET
}

model OtpCode {
  id                Int        @id @default(autoincrement())
  purpose           OtpPurpose
  identifier        String
  codeHash          String
  expiresAt         DateTime
  attemptsRemaining Int        @default(5)
  consumed          Boolean    @default(false)
  createdAt         DateTime   @default(now())

  @@index([identifier, purpose])
}

/// A single-use password reset link for a school admin.
///
/// A separate table from OtpCode rather than another OtpPurpose, because the two
/// are not the same kind of secret. An OTP is six digits a person retypes, so it
/// needs an attempt counter and a slow hash. This is 256 bits of CSPRNG output
/// that only ever travels inside a URL: nobody guesses it, so what it needs
/// instead is to be findable by its hash on the way back in, and to be spendable
/// exactly once.
model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, hex. The token itself is never stored — a leaked
  /// backup of this table must not hand anyone a working reset link. Unique
  /// because redemption looks a row up BY this value, and because two rows
  /// sharing one hash would make "which token was spent?" unanswerable.
  tokenHash String @unique

  expiresAt DateTime
  /// When the link was redeemed; null while it is still spendable. Set by a
  /// conditional update in src/routes/passwordReset.js, so two simultaneous
  /// redemptions of the same link race for one row and exactly one wins.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Requesting a reset supersedes that account's outstanding links, which is a
  /// delete by adminUserId.
  @@index([adminUserId])
}
