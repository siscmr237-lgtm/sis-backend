// Prisma schema for SIS using PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique @db.VarChar(16) // e.g., STU001
  school             School               @relation(fields: [schoolId], references: [id])
  schoolId           Int
  firstName          String
  lastName           String
  /// OPTIONAL. A school enrolling a child often does not have the birth
  /// certificate to hand on the day, and requiring it meant the student could
  /// not be entered at all until it turned up.
  ///
  /// NULL rather than a stand-in date: the create route used to fall back to
  /// "today", which stored a birthday that was silently wrong and then showed
  /// as fact on the profile. NULL reads as "not recorded", which is the truth,
  /// and the profile already renders a missing date as an em dash.
  dateOfBirth        DateTime?
  gender             String
  class              String
  /// OPTIONAL, both sides. A guardian's name and phone are often not available
  /// at the moment of enrolment, and a missing contact must not be what keeps a
  /// child off the roster.
  ///
  /// No link at all rather than a blank Parent row: Parent is deduped by
  /// @@unique([schoolId, name, phone]), so an empty name/phone pair would be one
  /// shared "nobody" record that every contactless student pointed at — and
  /// editing one child's guardian would then rewrite it for all of them. A NULL
  /// parentId says "no guardian on file" without inventing anyone.
  ///
  /// withFlatParent() in src/utils/parents.js already flattens a missing parent
  /// to empty parentName/parentPhone, so responses keep their existing shape.
  parent             Parent?              @relation(fields: [parentId], references: [id])
  parentId           Int?
  address            String
  enrollmentDate     DateTime
  allergies          String?
  medicalConditions  String?
  currentMedications String?
  medicalNotes       String?
  /// True when this student has been DETACHED from their class level's fee
  /// structure and billed from their own snapshot instead (scholarship, staff
  /// child, partial waiver). While set, feeOverrides below is the student's fee
  /// structure and the level sync skips them entirely, so a later class-level
  /// change does not silently undo the arrangement.
  ///
  /// A flag rather than "has override rows", because an override can legitimately
  /// be an EMPTY set — a student who owes nothing at all — which is a different
  /// thing from not being overridden.
  feesOverridden     Boolean              @default(false)
  feeOverrides       StudentFeeOverride[]
  ledgerEntries      LedgerEntry[]
  pickupContacts     PickupContact[]
  marks              StudentMark[]
  whatsappMessages   WhatsAppMessage[]

  /// WHO ENROLLED THIS STUDENT. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("StudentCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  @@index([schoolId])
  @@index([schoolId, class])
  @@index([parentId])
  @@index([createdByAdminId])
}

// A parent/guardian contact, shared across however many of their children are
// enrolled — editing this record (e.g. a corrected phone number) is visible
// to every linked Student. Deliberately dedupes only on an exact (schoolId,
// name, phone) match, never fuzzy — near-identical entries stay separate.
model Parent {
  id               Int               @id @default(autoincrement())
  school           School            @relation(fields: [schoolId], references: [id])
  schoolId         Int
  name             String
  phone            String
  /// Whether this guardian has AGREED to receive WhatsApp messages from the
  /// school. Gates the outbound absence notice and nothing else -- the existing
  /// fee-reminder and payment-confirmation routes predate it and are each sent
  /// by an admin looking at that one parent, which is a different act from a
  /// batch send to forty families at once.
  ///
  /// Defaults FALSE, and every row that exists before this migration therefore
  /// reads as no consent. That is the honest default: nobody enrolled before
  /// this field existed was ever asked, and a backfill to true would be the
  /// school asserting an agreement that never happened. It means the feature
  /// reaches nobody until each guardian is ticked individually, which is the
  /// intended cost of it.
  ///
  /// On PARENT rather than on Student because the phone number is here, and a
  /// guardian with three children at the school consented once, not three
  /// times. Ticking it on one child form ticks it for their siblings -- which
  /// is correct, and is also why the form says so out loud.
  whatsappConsent  Boolean           @default(false)
  students         Student[]
  whatsappMessages WhatsAppMessage[]

  @@unique([schoolId, name, phone])
  @@index([schoolId])
}

model PickupContact {
  id           Int      @id @default(autoincrement())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    Int
  name         String
  phone        String
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
}

model Staff {
  id                    Int                   @id @default(autoincrement())
  code                  String                @unique @db.VarChar(16) // e.g., STF001
  school                School                @relation(fields: [schoolId], references: [id])
  schoolId              Int
  firstName             String
  lastName              String
  /// OPTIONAL, and nullable rather than defaulting to '': it sits under
  /// @@unique([schoolId, idNumber]) below, where two empty strings would collide
  /// and the second staff member without an ID would be refused. NULLs are
  /// distinct in a unique index, so any number of rows may have none.
  idNumber              String?
  role                  String
  phone                 String
  // Scoped per school by the @@unique below, NOT globally: schools are separate
  // tenants, so one school having a staff member on an address must never stop
  // another school entering the same person — nor reveal, via a uniqueness
  // error, that the address exists somewhere else in the system.
  /// OPTIONAL — see idNumber above for why this is nullable and not ''. A staff
  /// member with no email simply has no way to be invited to log in:
  /// POST /staff/:id/invite already refuses when it is missing, and teacher
  /// sign-in looks accounts up BY email, so a NULL one matches nothing.
  email                 String?
  hireDate              DateTime
  salary                Int
  isTeacher             Boolean               @default(false)
  /// Set once a staff member has been given self-service login. NULL is the
  /// normal state for a newly created record and means "cannot log in yet" —
  /// not "locked out": every Staff row predates teacher login, so a nullable
  /// column is what lets existing staff keep working untouched while an admin
  /// issues credentials one at a time. Never compare a supplied password
  /// against a NULL hash; treat NULL as "no login" before any bcrypt call.
  passwordHash          String?
  /// Whether this staff member may log in at all, independent of whether they
  /// HAVE a password. Lets an admin revoke access — a teacher on suspension, or
  /// one who has left — without deleting the Staff row, which would take their
  /// work records, class assignments and ledger history with it.
  isActive              Boolean               @default(true)
  workRecords           WorkRecord[]
  classesAsClassTeacher Class[]               @relation("ClassTeacher")
  subjectAssignments    ClassSubjectTeacher[]
  ledgerEntries         LedgerEntry[]

  /// WHO ADDED THIS STAFF MEMBER. See the note on AdminUser.role.
  /// This person's own daily submissions. See the StaffAttendance model.
  staffAttendance StaffAttendance[]

  /// The browsers this teacher has granted notification permission on. One row
  /// per DEVICE, not per account — see PushSubscription.
  pushSubscriptions PushSubscription[]

  createdBy        AdminUser? @relation("StaffCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  // All three are scoped per school, never globally: the same person can
  // legitimately be on staff at more than one school, so one school holding
  // their email, phone or ID must not block another from entering them — nor
  // reveal, through a uniqueness error, that the value exists elsewhere.
  // Within a single school each stays unique.
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@unique([schoolId, idNumber])
  @@index([schoolId])
  @@index([createdByAdminId])
}

model Expense {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(16) // e.g., EXP001
  school        School   @relation(fields: [schoolId], references: [id])
  schoolId      Int
  date          DateTime
  category      String
  description   String
  amount        Int
  payee         String
  paymentMethod String
  // Per school, not global. Invoice numbers are each school's own document
  // series, so sequences like "INV-001" collide across tenants almost by
  // definition — a global constraint both blocks legitimate entry and leaks
  // that another school already used the number.
  invoiceNumber String

  /// WHO RECORDED THIS EXPENSE. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("ExpenseCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, date])
  @@index([createdByAdminId])
}

model AttendanceRecord {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(16) // e.g., ATT001
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   Int
  date       DateTime
  type       String
  personId   String
  personName String
  status     String
  remarks    String?

  /// WHO TOOK THIS REGISTER. Nullable on both counts, and for two different
  /// reasons. A teacher may mark attendance (POST /attendance/mark and /bulk),
  /// and a teacher is not an AdminUser — so the id stays NULL while the name
  /// records who it actually was. Every row written before this feature has
  /// neither, which reads as "not recorded" rather than as anybody.
  createdBy        AdminUser? @relation("AttendanceRecordCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  /// One record per person per DAY. Attendance is a yes/no fact about a date, so
  /// a second row for the same person and day is never a second fact — it is a
  /// duplicate that double-counts in every percentage derived from it, including
  /// the term consistency figure the report card consumes.
  ///
  /// `date` is normalised to midnight UTC on write (see src/utils/attendanceDay.js);
  /// without that this index would key on the timestamp and happily admit two
  /// rows for the same calendar day.
  @@unique([schoolId, type, personId, date])
  @@index([schoolId, date])
  @@index([schoolId, personId])
  @@index([createdByAdminId])
}

/// Whether a staff member was at work. Two values, deliberately: this is the
/// register a teacher takes of THEMSELVES, and "late" or "excused" are
/// judgements somebody else makes about the day, not facts the person submits.
/// AttendanceRecord.status stays the free-text column it has always been.
enum StaffAttendanceStatus {
  PRESENT
  ABSENT
}

/// Where a submission stands with the school.
///
/// PENDING is where every submission starts, and it is a real state rather than
/// a formality: a teacher marking themselves present marks their whole class
/// present with them, and until somebody says otherwise that is a claim, not a
/// finding. It becomes APPROVED by an Owner, or by the 48-hour sweep in
/// src/routes/cron.js when nobody got to it.
enum StaffAttendanceApproval {
  PENDING
  APPROVED
  REJECTED
}

/// A STAFF MEMBER'S OWN SUBMISSION for one day, and what became of it.
///
/// NOT the same thing as an AttendanceRecord with type = 'staff', and the two
/// must never be conflated. Those rows are what an ADMIN recorded ABOUT someone
/// from the Staff Attendance tab; this table is what the person SUBMITTED about
/// themselves, and it carries an approval lifecycle those rows have no concept
/// of. A day can legitimately have both, saying different things — which is the
/// point of keeping them apart rather than overloading one column.
///
/// The student register a submission carries with it lives where it always has,
/// in AttendanceRecord. This table does not duplicate it: rejecting a submission
/// rewrites those rows (see POST /staff-attendance/:id/reject), it does not
/// store a second copy of them.
model StaffAttendance {
  id             Int                     @id @default(autoincrement())
  school         School                  @relation(fields: [schoolId], references: [id])
  schoolId       Int
  staff          Staff                   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId        Int
  /// Normalised to midnight UTC on write, exactly as AttendanceRecord.date is —
  /// see startOfDayUTC in src/utils/attendanceDay.js. Without that the unique
  /// index below would key on the time of day and admit a second submission for
  /// the same calendar day, which is the one thing it exists to prevent.
  date           DateTime
  status         StaffAttendanceStatus
  /// WHEN IT WAS SUBMITTED, and the only clock the 48-hour auto-approval reads.
  /// Deliberately its own column rather than leaning on createdAt: createdAt is
  /// a row-lifecycle timestamp that any future backfill, import or repair would
  /// move, and moving it would silently reset somebody's approval window.
  submittedAt    DateTime                @default(now())
  approvalStatus StaffAttendanceApproval @default(PENDING)
  /// Who approved it — an AdminUser, or NULL when the 48-hour sweep did it with
  /// nobody looking. A null approver next to a non-null approvedAt is therefore
  /// meaningful: it says the school never answered. ON DELETE SET NULL, never
  /// cascade: an account going away must not delete the decision it made.
  approvedBy     AdminUser?              @relation("StaffAttendanceApprovedBy", fields: [approvedById], references: [id])
  approvedById   Int?
  approvedAt     DateTime?
  /// Who rejected it. Always an AdminUser — nothing automatic ever rejects, so
  /// unlike approvedById a null here alongside a rejectedAt would be a bug.
  rejectedBy     AdminUser?              @relation("StaffAttendanceRejectedBy", fields: [rejectedById], references: [id])
  rejectedById   Int?
  rejectedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  /// ONE SUBMISSION PER STAFF MEMBER PER DAY, enforced by the database rather
  /// than by a check-then-insert two tabs could race through.
  ///
  /// Keyed on (staffId, date) and NOT on schoolId as well: a Staff row belongs
  /// to exactly one school, so adding schoolId could only ever weaken this —
  /// a wrong schoolId would let a second row through for the same person and
  /// day, which is precisely what must not happen.
  @@unique([staffId, date])
  @@index([schoolId, date])
  /// The 48-hour sweep's query, exactly: PENDING rows older than a cutoff.
  @@index([approvalStatus, submittedAt])
}

model WorkRecord {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(16) // e.g., WR001
  staff      Staff    @relation(fields: [staffId], references: [id])
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   Int
  staffId    Int
  staffName  String
  date       DateTime
  subject    String
  class      String
  topic      String
  objectives String
  activities String
  evaluation String
  remarks    String?

  /// WHO WROTE THIS RECORD UP. See the note on AdminUser.role.
  createdBy        AdminUser? @relation("WorkRecordCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  @@index([schoolId])
  @@index([staffId, schoolId])
  @@index([createdByAdminId])
}

model ReportCard {
  id                 Int    @id @default(autoincrement())
  code               String @unique @db.VarChar(16) // e.g., RC001
  school             School @relation(fields: [schoolId], references: [id])
  schoolId           Int
  studentId          String
  studentName        String
  class              String
  term               String
  academicYear       String
  subjects           Json
  averageScore       Int
  position           Int
  totalStudents      Int
  attendance         Int
  headTeacherComment String

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([schoolId, term, academicYear])
}

model TimetableEntry {
  id       Int    @id @default(autoincrement())
  code     String @unique @db.VarChar(16) // e.g., TT001
  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int
  day      String
  time     String
  class    String
  subject  String
  teacher  String

  @@index([schoolId])
  @@index([schoolId, class])
}

model Class {
  id              Int                   @id @default(autoincrement())
  code            String                @unique @db.VarChar(16)
  name            String
  school          School                @relation(fields: [schoolId], references: [id])
  schoolId        Int
  classTeacher    Staff?                @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  classTeacherId  Int?
  subjectTeachers ClassSubjectTeacher[]
  testExams       TestExam[]

  @@unique([name, schoolId])
}

model Subject {
  id                 Int                    @id @default(autoincrement())
  name               String
  school             School                 @relation(fields: [schoolId], references: [id])
  schoolId           Int
  classLevelSubjects ClassLevelSubject[]
  subjectTeachers    ClassSubjectTeacher[]
  subjectTotals      TestExamSubjectTotal[]
  marks              StudentMark[]

  @@unique([name, schoolId])
}

/// Which subjects a class LEVEL teaches — "Class 1", "Nursery 1" — shared by
/// every section of it. This replaced a per-Class (per-SECTION) link: sections of
/// one level are the same grade taught twice, so giving them independent subject
/// lists let them silently diverge, and the admin had to repeat every change per
/// section.
///
/// Mirrors ClassLevelFee exactly, including storing the level as a string rather
/// than pointing at a Class row: the level is a concept above the Class table
/// (several sections map to one level, and a level can be configured before any
/// section of it exists). src/utils/classLevels.js is the only place a level is
/// derived from a class name.
model ClassLevelSubject {
  id         Int     @id @default(autoincrement())
  school     School  @relation(fields: [schoolId], references: [id])
  schoolId   Int
  classLevel String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  Int

  @@unique([schoolId, classLevel, subjectId])
  @@index([schoolId, classLevel])
}

model ClassSubjectTeacher {
  id        Int     @id @default(autoincrement())
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   Int
  staff     Staff   @relation(fields: [staffId], references: [id])
  staffId   Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int

  @@unique([classId, staffId, subjectId])
}

enum TestExamType {
  TEST
  EXAM
}

// A single test/exam instance (e.g. "CA1", "End of Term Exam"), always scoped
// to exactly one class — never shared or reused across classes, even when two
// classes teach the same subject under the same name.
model TestExam {
  id                    Int                    @id @default(autoincrement())
  school                School                 @relation(fields: [schoolId], references: [id])
  schoolId              Int
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId               Int
  academicYear          String
  term                  String
  name                  String
  type                  TestExamType
  order                 Int                    @default(0)
  subjectTotals         TestExamSubjectTotal[]
  studentMarks          StudentMark[]
  // Set once the term this assessment belongs to has ended and every still-
  // unmarked student has been given a 0 (see src/utils/termEndZeros.js). This
  // is what makes the sweep idempotent: an assessment is only ever processed
  // while this is null, so a second run cannot re-zero a mark a teacher has
  // since edited. Left null on assessments created after their term ended
  // until the next sweep picks them up.
  termEndZerosAppliedAt DateTime?
  // When this assessment was first WRITTEN — the moment any student in its class
  // first had a mark recorded for it, in any subject. Set once and never
  // cleared: a partly-graded test cannot become un-written, so deleting every
  // mark afterwards does not undo it.
  //
  // Distinct from termEndZerosAppliedAt, which is about the calendar. This is
  // about the test actually having been sat, and it is what licenses the
  // save-time zero fill in the bulk marks endpoint: once a paper has been
  // written, a student with no score did not miss the marking, they scored zero.
  activatedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([classId, academicYear, term, name])
  @@index([schoolId])
  @@index([classId, academicYear, term])
  // Drives the sweep's "anything left to zero?" lookup, which runs on ordinary
  // reads and must stay cheap when the answer is no.
  @@index([schoolId, termEndZerosAppliedAt])
}

// The school-configured total marks for one subject on one test/exam. Set
// manually per subject per test/exam, so totals can differ both across
// tests/exams and across subjects within the same test/exam.
model TestExamSubjectTotal {
  id         Int      @id @default(autoincrement())
  testExam   TestExam @relation(fields: [testExamId], references: [id], onDelete: Cascade)
  testExamId Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId  Int
  totalMarks Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([testExamId, subjectId])
}

// A student's score for one subject on one test/exam. Can only be created
// once the matching TestExamSubjectTotal exists; marksObtained is enforced
// (at the application layer) to never exceed that configured total.
//
// Three states, and the absence of a row is one of them:
//   MARKED   — a row with isExempt = false and a number in marksObtained. A 0
//              here is a real score of zero, whether a teacher typed it or the
//              term-end sweep filled it in; nothing distinguishes the two,
//              because for every purpose a zero is just a zero.
//   EXEMPT   — a row with isExempt = true and marksObtained NULL. Excluded from
//              the student's score AND their denominator: never a zero, never
//              counted. Reversible.
//   UNMARKED — NO ROW. Excluded from the denominator during the term, then
//              converted to a marked 0 once the term ends.
//
// A CHECK constraint (see the accompanying migration) enforces that exactly one
// of isExempt/marksObtained is set, so a row can never be both at once or
// neither — a state no application path produces but which would silently
// corrupt every total if it ever appeared.
model StudentMark {
  id            Int      @id @default(autoincrement())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     Int
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId     Int
  testExam      TestExam @relation(fields: [testExamId], references: [id], onDelete: Cascade)
  testExamId    Int
  marksObtained Int?
  isExempt      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentId, subjectId, testExamId])
  @@index([testExamId])
  @@index([subjectId])
  @@index([studentId])
}

enum SchoolType {
  DAYCARE_NURSERY
  DAYCARE_NURSERY_PRIMARY
}

/// Where a school stands in signing up, as ONE column rather than a set of
/// booleans that can disagree with each other. The four values are a strict
/// progression and a school occupies exactly one of them at a time:
///
///   FAILED     — signed up, email not verified. The account exists but has
///                proved nothing about itself yet.
///   INCOMPLETE — email verified, KYC not submitted.
///   PENDING    — KYC submitted, awaiting a decision from the platform team.
///   APPROVED   — approved. This is the ONLY value that opens the dashboard.
///
/// There is deliberately no REJECTED value. A school the team is not happy with
/// is left PENDING and sends itself back with "Not Done", which returns it to
/// INCOMPLETE to re-submit — so a refusal is never a dead end the school cannot
/// act on, and there is no state the product has no screen for.
enum RegistrationStatus {
  FAILED
  INCOMPLETE
  PENDING
  APPROVED
}

/// The proprietor's gender, and the only thing it decides: the honorific in
/// front of their initials on generated correspondence — "Mme" for FEMALE,
/// "Sir" for MALE. See feeDriveSignature in src/utils/proprietor.js.
///
/// NULL (the column is optional) means nobody has said yet, and that is a
/// third state rather than a missing one: the signature drops the honorific and
/// prints the bare initials instead of putting a title on a letter that no one
/// chose, over a named person's initials.
enum ProprietorGender {
  MALE
  FEMALE
}

model School {
  id                        Int                    @id @default(autoincrement())
  name                      String
  /// THE SHORT NAME, AND THE RECEIPT PREFIX. "CNPS", "BKNPS", "CIGBINAPS".
  ///
  /// It began as a cosmetic label for places the full name will not fit — the
  /// dashboard header, the teacher sidebar — and it is still that. It is now
  /// also the first half of every receipt number this school issues: "CNPS001".
  /// That is why the format is constrained to uppercase letters and digits,
  /// 2–10 characters, and validated on every write. See
  /// src/utils/schoolAbbreviation.js, which is the only place those rules live.
  ///
  /// REQUIRED. NOT NULL since the column was added, set from the school name at
  /// signup and editable in School Settings from then on. A school with no
  /// valid abbreviation cannot record a payment at all — issueReceiptNumber
  /// refuses rather than invent a prefix.
  ///
  /// NOT GLOBALLY UNIQUE, and deliberately no unique index. A receipt is only
  /// ever looked up within one school — the finance search, the ledger, the
  /// student profile are all scoped by schoolId, and the index that guarantees
  /// receipt numbers do not collide is (schoolId, receiptNumber). Two schools
  /// both calling themselves "SJS" and both issuing an SJS001 is correct: those
  /// are two different receipts belonging to two different schools, and neither
  /// office can see the other's. A global constraint here would buy nothing and
  /// would mean telling a real school it may not use its own initials.
  ///
  /// CHANGING IT LATER DOES NOT RENUMBER ANYTHING, and this is the part that
  /// looks like a bug to whoever finds it next. The prefix is baked into
  /// LedgerEntry.receiptNumber as text at the moment the receipt is issued, and
  /// never recomputed. So a school that changes "CNPS" to "ENPS" ends up with
  /// CNPS001..CNPS015 followed by ENPS016 — one school, one continuous
  /// sequence, two prefixes in it.
  ///
  /// That is the correct behaviour and must not be "fixed" by a backfill.
  /// CNPS014 is printed on a paper receipt and sitting in a parent's WhatsApp
  /// history; rewriting it to ENPS014 would mean the number that family was
  /// told to quote no longer exists anywhere. Old receipts keep the prefix they
  /// were issued under, new ones use the new prefix, and both remain findable
  /// because the office search matches on a partial number and neither prefix
  /// is required to type it.
  abbreviation              String
  /// VESTIGIAL. It once drove a toggle that re-derived the abbreviation from the
  /// school name on every save; that behaviour is gone (renaming a school must
  /// not silently rewrite a prefix that is now on receipts), and nothing reads
  /// this column. Kept only because dropping it needs a migration for no gain.
  abbreviationAutoGenerated Boolean                @default(true)
  logo                      String
  /// The school's ACTIVE academic year, "2026/2027" (a Sept–June window). This is
  /// now the single source of truth for the year: it is advanced by
  /// advanceYearIfDue (manual button, Aug nudge, Sept auto-advance) and is NEVER
  /// recomputed from today's date. Terms still cycle automatically by date within
  /// it — only the YEAR follows the manual → nudge → auto flow.
  academicYear              String
  /// The earliest year this school could have data for, derived from its signup
  /// date (the owning AdminUser's createdAt) rather than any user-entered field.
  /// Stored once so the year dropdown's lower bound is stable and cheap to read.
  firstAcademicYear         String?
  /// Set to the destination year when the year advanced AUTOMATICALLY, and cleared
  /// when the school acknowledges it. Its presence is what drives the one-time
  /// dismissible "Your academic year has changed to …" notice; a manual advance
  /// leaves it null, since the admin already knows.
  autoAdvancedYear          String?
  currentTerm               String
  autoTermEnabled           Boolean                @default(true)
  /// THE SCHOOL-LEVEL OPT-OUT for push notifications. FALSE means send this
  /// school's admins and teachers NOTHING — not fewer reminders, not only the
  /// urgent ones. Every push path checks it, including the immediate
  /// attendance-rejection notification, which is not a reminder at all.
  ///
  /// Separate from ReminderConfig.enabled, and deliberately so: that one is the
  /// team silencing a single reminder for every school, this one is a school
  /// silencing everything for itself. Neither implies the other, so both are
  /// consulted on every send.
  ///
  /// Defaults true so the feature arrives switched on and every existing school
  /// keeps behaving exactly as it does now.
  notificationsEnabled      Boolean                @default(true)
  motto                     String?
  /// Only ever read to build the honorific on a Fee Drive letter — see the
  /// ProprietorGender enum above. The proprietor's NAME is deliberately not
  /// duplicated here: it is adminUser.name, the account that owns this school,
  /// and a copy would be a second answer to "who is the proprietor?" that
  /// nothing keeps in step with the first.
  proprietorGender          ProprietorGender?
  address                   String?
  schoolType                SchoolType?
  uniformColors             Json                   @default("{\"shirt\":null,\"trouser\":null,\"gown\":null}")
  onboardingCompleted       Boolean                @default(true)
  /// The approval gate. Read LIVE from this column on every authenticated
  /// request (loadAdminActor includes School), never from a claim inside the
  /// session token — approval is granted while a token is still valid, so a
  /// cached copy would leave an approved school locked out, and an unapproved
  /// one let in, for the rest of its idle window.
  ///
  /// Kept alongside onboardingCompleted rather than replacing it: that flag
  /// still answers "has KYC been submitted?", which the setup wizard and the
  /// dashboard checklist both depend on. PENDING and APPROVED both imply
  /// onboardingCompleted = true; this column adds what happened after.
  registrationStatus        RegistrationStatus     @default(INCOMPLETE)
  /// When the admin last left the post-KYC setup wizard, by finishing it or by
  /// skipping out of it. NULL means they have never been through it, which is
  /// the only thing that makes the wizard appear.
  ///
  /// This is NOT progress tracking. It records that the wizard was SEEN and
  /// nothing about what was set up: every step's done/not-done is still read
  /// live from the tables, by the same code the dashboard checklist uses.
  /// Skipping a step leaves no trace anywhere — it simply has no data, so the
  /// checklist lists it as outstanding. The two are one system: the wizard
  /// guides once, the checklist catches whatever was skipped, and they cannot
  /// disagree because neither stores an opinion about completeness.
  ///
  /// A timestamp rather than a boolean so it is possible to tell WHEN a school
  /// dismissed it; a bare `true` says nothing useful a month later.
  setupWizardCompletedAt    DateTime?
  subjectsPerClass          Json
  /// THE OWNER. Named because there are now two relations between School and
  /// AdminUser and Prisma disambiguates them by name; naming an explicit
  /// fields/references relation changes no SQL — the column and the constraint
  /// keep the names they already have.
  adminUser                 AdminUser              @relation("SchoolOwner", fields: [adminUserId], references: [id])
  adminUserId               Int
  /// The ADMINISTRATOR accounts the owner has invited into this school. They do
  /// not own it — adminUserId above is still the single owning account — so this
  /// is the only thing that scopes them to a school at all. See loadAdminActor.
  admins                    AdminUser[]            @relation("SchoolAdmins")
  Student                   Student[]
  Parent                    Parent[]
  Staff                     Staff[]
  Expense                   Expense[]
  AttendanceRecord          AttendanceRecord[]
  staffAttendance           StaffAttendance[]
  WorkRecord                WorkRecord[]
  ReportCard                ReportCard[]
  TimetableEntry            TimetableEntry[]
  Class                     Class[]
  Subject                   Subject[]
  chargeCategories          ChargeCategory[]
  classLevelFees            ClassLevelFee[]
  classLevelNoFees          ClassLevelNoFees[]
  classLevelSubjects        ClassLevelSubject[]
  studentFeeOverrides       StudentFeeOverride[]
  ledgerEntries             LedgerEntry[]
  TestExam                  TestExam[]
  whatsappMessages          WhatsAppMessage[]
  receiptIssues             ReceiptIssue[]
  receiptCounters           ReceiptCounter[]
  retiredReceiptNumbers     RetiredReceiptNumber[]
  pushSubscriptions         PushSubscription[]
}

model ChargeCategory {
  id        Int           @id @default(autoincrement())
  name      String
  limit     Int           @default(0)
  isBuiltIn Boolean       @default(false)
  forStaff  Boolean       @default(false)
  /// WHICH WAY the money runs, for staff categories only.
  ///
  /// The staff ledger already had a direction baked into it: a CHARGE meant the
  /// SCHOOL owed the staff member (salary accrued, a bonus due, an allowance)
  /// and a PAYMENT meant the school had paid them, so balance = charged - paid
  /// was "what we still owe this person".
  ///
  /// Staff FINES run the other way — a broken window or a late-coming penalty is
  /// money the staff member owes the SCHOOL. Stored as a plain CHARGE it would
  /// have increased what the school appears to owe them, which is precisely
  /// backwards, so the direction is marked on the category instead.
  ///
  /// Defaults false, which is what makes this migration a no-op: every category
  /// that already exists (Salary, Bonus, Damage, Staff Expense, Transportation
  /// Allowance) keeps its original meaning untouched.
  staffOwes Boolean       @default(false)
  school    School        @relation(fields: [schoolId], references: [id])
  schoolId  Int
  entries   LedgerEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([name, schoolId])
}

/// A fee belonging to a class LEVEL — "Class 1", "Nursery 1" — never to a
/// section and never to the school. Every section of a level ("Class 1 A",
/// "Class 1 B") shares one fee structure, which is why classLevel stores the
/// level name rather than pointing at a Class row: a section is not the owner,
/// and adding or removing sections must not disturb the fees.
///
/// classLevel is a plain string rather than an FK because the level is a
/// concept above the Class table (several Class rows map to one level, and a
/// level can be configured before any section of it exists). src/utils/
/// classLevels.js is the only place that derives a level from a class name.
model ClassLevelFee {
  id                     Int           @id @default(autoincrement())
  school                 School        @relation(fields: [schoolId], references: [id])
  schoolId               Int
  classLevel             String
  name                   String
  /// What every student of this level is charged for this fee. 0 is a real,
  /// valid value: the defaults are seeded with no amount so a school fills in
  /// its own, and a guessed figure would look authoritative.
  amount                 Int           @default(0)
  /// How much of `amount` must be paid for this fee to count as part of the
  /// first installment — an absolute figure, not a share. NULL means the
  /// category asks nothing upfront: it is met automatically and contributes
  /// zero to the required total, so the level's whole first-installment rule
  /// is "every fee where this is non-null and above 0".
  ///
  /// Never above `amount`. Enforced on every write rather than only in the
  /// dialog, because a requirement larger than the bill is unmeetable — the
  /// student could pay the fee in full and still read as short.
  /// clampFirstInstallmentAmount is the one place that clamp lives.
  firstInstallmentAmount Float?
  /// Which fixed group this fee belongs to. REGISTRATION is structurally
  /// outside the first-installment rule — see computeStudentFeesStatus, which
  /// drops these fees from the rule whatever firstInstallmentAmount says on
  /// them. OTHER_FEES is the default and covers everything else.
  group                  FeeGroup      @default(OTHER_FEES)
  charges                LedgerEntry[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([schoolId, classLevel, name])
  @@index([schoolId, classLevel])
}

/// A class level the school has declared it charges NOTHING for.
///
/// Needed because "this level has no fees" and "nobody has set this level's fees
/// up yet" look identical in the data, and the setup checklist has to tell them
/// apart — otherwise a school with a free nursery can never finish the fees step
/// and the card nags forever. A row here is an explicit statement, not an
/// absence.
///
/// A LEVEL, not a class, matching ClassLevelFee: fees belong to the level and
/// every section shares one structure, so the declaration has to sit at the same
/// grain or the two could disagree about a single section.
///
/// The invariant this must never break: a level cannot be both free and charged.
/// Saving any fee with an amount above 0 deletes the row (see PUT
/// /classes/levels/:level/fees), and levelFeeSetupStatus ignores the row anyway
/// whenever the level has a charged fee, so even a stale row cannot produce the
/// contradiction.
model ClassLevelNoFees {
  id         Int      @id @default(autoincrement())
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   Int
  classLevel String
  /// When it was declared free. A timestamp rather than a bare flag so the
  /// answer to "when did they decide this?" survives.
  markedAt   DateTime @default(now())

  @@unique([schoolId, classLevel])
  @@index([schoolId])
}

/// One fee in a single student's PERSONAL fee structure, used when they have been
/// detached from their class level's (Student.feesOverridden).
///
/// A snapshot, not a diff against the level: the dialog pre-fills it from the
/// level's current fees and the admin adjusts down, so from then on the student's
/// bill is fully described here. Storing deltas instead would mean the meaning of
/// a waiver silently changed whenever the class fee moved, which is exactly what
/// detaching is meant to prevent.
model StudentFeeOverride {
  id                     Int           @id @default(autoincrement())
  school                 School        @relation(fields: [schoolId], references: [id])
  schoolId               Int
  student                Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId              Int
  name                   String
  amount                 Int           @default(0)
  /// Same meaning as on ClassLevelFee: an absolute amount, NULL meaning this
  /// category asks nothing upfront and is met automatically. Never above
  /// `amount`.
  firstInstallmentAmount Float?
  /// Which fixed group this fee belongs to. REGISTRATION is structurally
  /// outside the first-installment rule — see computeStudentFeesStatus, which
  /// drops these fees from the rule whatever firstInstallmentAmount says on
  /// them. OTHER_FEES is the default and covers everything else.
  group                  FeeGroup      @default(OTHER_FEES)
  charges                LedgerEntry[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([studentId, name])
  @@index([schoolId])
}

/// Which of the two fixed groups a fee category belongs to.
///
/// Exactly two, deliberately closed. A school cannot add a third, rename these,
/// or configure them: the whole point is that REGISTRATION means the same thing
/// in every school, because the first-installment rule is defined in terms of
/// it. A school-nameable group would make that rule mean whatever each school
/// happened to type.
///
/// An enum rather than a string so the database refuses anything else — a typo
/// in a group name would silently move a fee out of Registration and quietly
/// change who has met their first installment.
enum FeeGroup {
  REGISTRATION
  OTHER_FEES
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
}

model LedgerEntry {
  id                   Int                 @id @default(autoincrement())
  code                 String              @unique @db.VarChar(16)
  type                 LedgerEntryType
  school               School              @relation(fields: [schoolId], references: [id])
  schoolId             Int
  student              Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId            Int?
  staff                Staff?              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId              Int?
  category             ChargeCategory?     @relation(fields: [categoryId], references: [id])
  categoryId           Int?
  /// Set on the one CHARGE row that bills a student for a class-level fee.
  /// Exactly one such row exists per (student, fee) — see the compound unique
  /// below — so when a level's amount changes that row is updated in place and
  /// the student's total charged always equals the level's current fee
  /// structure. That is what makes a fee change apply to EXISTING charges
  /// rather than only future ones.
  classLevelFee        ClassLevelFee?      @relation(fields: [classLevelFeeId], references: [id], onDelete: Cascade)
  classLevelFeeId      Int?
  /// True only on the row that bills the class level's fee STRUCTURE — the one
  /// syncLevelFeeCharges owns and rewrites when the level's amount changes.
  ///
  /// An admin can also record an EXTRA charge against the same fee category
  /// (say a second Tuition charge). Those carry classLevelFeeId too, so they
  /// count toward that category's first-installment maths exactly like the
  /// billed charge, but isFeeStructureCharge is false so the level sync leaves
  /// them alone instead of overwriting them with the structural amount.
  ///
  /// A partial unique index — (studentId, classLevelFeeId) WHERE
  /// isFeeStructureCharge — keeps exactly one structural row per student per
  /// fee while allowing any number of extra charges. It is created in raw SQL
  /// in the migration because Prisma cannot express a partial index.
  isFeeStructureCharge Boolean             @default(false)
  /// The override fee this charge bills, for a DETACHED student. Exactly one of
  /// classLevelFeeId / studentFeeOverrideId is set on a fee-linked charge: the
  /// first while a student follows their class, the second once they have their
  /// own structure. Both null means a one-off charge, outside any fee structure.
  studentFeeOverride   StudentFeeOverride? @relation(fields: [studentFeeOverrideId], references: [id], onDelete: Cascade)
  studentFeeOverrideId Int?
  /// The short label shown wherever this entry is listed — for a charge raised by
  /// hand this is its NAME ("Broken window", "Trip"). Required, and long-standing.
  description          String
  /// The longer reason behind a charge, beyond that label. Nullable because
  /// nothing that already exists has one and most entries never need one; the
  /// charge form offers it as an optional third field.
  note                 String?
  /// For a PAYMENT, the specific CHARGE it settles.
  ///
  /// This is what makes a standalone charge — a fine, a replaced book — payable
  /// on its own. Fee-structure money is tied to a ClassLevelFee or a
  /// StudentFeeOverride, but a one-off charge belongs to no structure, so before
  /// this there was no way to say "this money settled that fine" and such charges
  /// could only be cleared by an untagged payment.
  ///
  /// Deliberately NOT modelled as a StudentFeeOverride: that would flip
  /// feesOverridden and silently convert the student to custom fees, when a fine
  /// has nothing to do with their fee structure.
  ///
  /// ON DELETE SET NULL, never cascade: deleting a charge must not delete the
  /// money someone actually handed over. The payment survives, untagged.
  settles              LedgerEntry?        @relation("EntrySettlement", fields: [settlesEntryId], references: [id], onDelete: SetNull)
  settlesEntryId       Int?
  settledBy            LedgerEntry[]       @relation("EntrySettlement")
  /// The month this PAYMENT is the payroll run for, as an absolute "2026-09".
  ///
  /// Set ONLY on the one row that pays a staff member for a month, which is what
  /// makes the unique index below mean "a month can be paid at most once". The
  /// key is absolute rather than a bare month name so it can never be ambiguous
  /// about which September it refers to; the academic year a month belongs to is
  /// derived from it, not stored twice.
  ///
  /// Null on everything else — every charge, every student row, and the
  /// settlement rows a payroll run creates. Postgres treats NULLs as distinct in
  /// a unique index, so those rows are unconstrained.
  payrollMonth         String?
  /// The BONUS portion of a payroll run's `amount`, so the salary portion is
  /// `amount - payrollBonus`. Held as a split of one row rather than a second
  /// row because the two are one event: the cap applies to the salary portion
  /// alone (a bonus is on top and is never capped), and deleting the payroll
  /// must not be able to leave a bonus behind with nothing to belong to.
  /// The reason for the bonus goes in `note`.
  payrollBonus         Int?
  amount               Int
  entryDate            DateTime
  paymentMethod        String?
  /// THE RECEIPT NUMBER, e.g. "CNPS042". Payments only.
  ///
  /// NULLABLE FOREVER, and not because the data is incomplete. Payments are not
  /// their own table — they are LedgerEntry rows with type PAYMENT — so every
  /// CHARGE row in this table will hold null here for as long as the table
  /// exists. A NOT NULL constraint could therefore never be added. The real
  /// invariant is "every row with type PAYMENT has one", which the issuing path
  /// upholds and the tests assert; the database enforces UNIQUENESS, which is
  /// the half it can enforce.
  ///
  /// Unique per school, not globally: two schools that share an abbreviation
  /// both numbering a receipt SJS001 is correct and expected. Postgres permits
  /// many NULLs under a unique index, which is what lets every charge row
  /// coexist.
  ///
  /// THE PREFIX IS FROZEN INTO THIS STRING at the moment of issue and is never
  /// recomputed from the school row. A school that changes its abbreviation
  /// keeps every receipt it has already issued exactly as it issued them — see
  /// the note on School.abbreviation for why that is deliberate.
  ///
  /// IMMUTABLE once issued. Editing a payment's amount or date must never
  /// reissue it — a parent may already be holding the old number. See
  /// src/utils/receiptNumber.js.
  receiptNumber        String?
  /// THE NUMBER THIS PAYMENT USED TO HAVE, "2026/2027-0042", for the rows that
  /// existed before the format changed. Null on everything issued since, and
  /// null on every charge.
  ///
  /// WHY IT IS KEPT RATHER THAN DISCARDED. Ninety-nine payments were renumbered
  /// when the format changed, and five of them had already been quoted to a
  /// parent in a WhatsApp message that was delivered and, in three cases, read.
  /// A number a family is holding cannot simply stop existing: they ring the
  /// office reading "2026/2027-0014" off their phone, and a search that returns
  /// nothing tells them the school has lost their payment. One nullable column
  /// removes that entirely.
  ///
  /// THE OFFICE SEARCH MATCHES EITHER — see the searchFilter in routes/ledger.js.
  /// One consequence, accepted rather than overlooked: a short query like "001"
  /// now matches both CNPS001 and the legacy 2026/2027-0001, which are two
  /// different payments. That ambiguity is the temporary price of keeping old
  /// numbers findable while families still hold them, and it shrinks to nothing
  /// as the legacy numbers age out of circulation.
  ///
  /// WRITE-ONCE, by the migration only. Nothing in the issuing path sets it and
  /// no route accepts it.
  legacyReceiptNumber  String?
  /// THE SUBMISSION THIS ROW CAME FROM. Payments only; null on charges and on
  /// every row written before batching existed.
  ///
  /// Pay Fees is ONE act that creates SEVERAL rows — 10,000 Books, 1,000 PTA,
  /// 30,000 Tuition is a parent handing over 41,000 once. Nothing recorded that
  /// they belonged together, so a receipt built per row told the family about
  /// three payments they did not make.
  ///
  /// An opaque server-generated token, never shown and never accepted from a
  /// client: a client-supplied one could merge two submissions or forge a row
  /// into somebody else's.
  ///
  /// EVERY payment path sets one, including the single-payment route, where the
  /// batch is simply of one. That keeps "a submission" a uniform idea — without
  /// it a lone payment would have no batch to confirm and no batch to retry.
  ///
  /// It groups rows written TOGETHER, not money handed over together. Recording
  /// Tuition and then remembering Books a minute later is two submissions and
  /// two messages. That is deliberate: merging on a time window works until two
  /// cashiers overlap, and then quietly merges two families' payments.
  paymentBatchId       String?
  whatsappMessages     WhatsAppMessage[]
  academicYear         String
  term                 String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  /// WHO RECORDED THIS ENTRY. NULL on both columns for the fee-structure rows
  /// syncLevelFeeCharges writes: nobody records those by hand, so attributing
  /// them to whoever happened to trigger the sync would name the wrong person.
  /// See isFeeStructureCharge above and the note on AdminUser.role.
  createdBy        AdminUser? @relation("LedgerEntryCreatedBy", fields: [createdByAdminId], references: [id])
  createdByAdminId Int?
  createdByName    String?

  /// A staff member's month can be paid at most once, enforced by the database
  /// rather than by a check-then-insert that two admins could race through.
  /// Only payroll rows carry a payrollMonth, and NULLs are distinct in Postgres,
  /// so this constrains nothing else.
  @@unique([staffId, payrollMonth])
  /// The same guarantee for the OLD numbers, carried over rather than dropped.
  /// They were unique per school when they were issued and the migration must
  /// not be able to land two rows on one legacy number — a duplicate here would
  /// mean a parent's number resolving to two payments, which is precisely the
  /// failure this column exists to prevent.
  @@unique([schoolId, legacyReceiptNumber])
  /// NOT UNIQUE ANY MORE, and that is the point of the change rather than an
  /// oversight.
  ///
  /// It was @@unique([schoolId, receiptNumber]) — one row, one number. A receipt
  /// number now names a SUBMISSION, and a submission is several rows: a family
  /// handing over 90,500 for seven fees is one payment with one number written
  /// onto all seven rows. Under the old index the second of those rows was
  /// refused outright.
  ///
  /// THE GUARANTEE DID NOT GO, IT MOVED. "No two submissions in a school share a
  /// number" is now enforced by the ReceiptIssue table, which holds exactly one
  /// row per number issued. It has to live there: once a number legitimately
  /// repeats down this column, no index on this table can express the rule any
  /// more. See the ReceiptIssue model.
  ///
  /// An ordinary index, because the office search and the batch lookups still
  /// read by this column constantly.
  @@index([schoolId, receiptNumber])
  @@index([studentId, schoolId])
  @@index([staffId, schoolId])
  @@index([schoolId])
  @@index([schoolId, academicYear, term])
  @@index([classLevelFeeId])
  @@index([studentFeeOverrideId])
  /// Drives "how much of this charge has been settled?", which the owing endpoint
  /// asks per standalone charge.
  @@index([settlesEntryId])
  @@index([schoolId, paymentBatchId])
  @@index([createdByAdminId])
}

/// Who an account is INSIDE ONE SCHOOL. Nothing to do with PlatformRole, which
/// is a role on the internal team — the two enums live on different tables and
/// must never be compared or substituted for one another. Nor with Staff.role,
/// which is a free-text job title.
enum AdminRole {
  /// The account created at signup, which owns the School row. It may do
  /// anything: edit or delete any record whoever made it, and invite and remove
  /// Administrators.
  OWNER
  /// An account the Owner invited. It does the day-to-day work but may only
  /// edit what it created itself, may delete nothing, and cannot see the
  /// Administrators section at all. Enforced in the API, not by hiding buttons.
  ADMINISTRATOR
}

model AdminUser {
  id               Int       @id @default(autoincrement())
  /// OPTIONAL since Administrator invites. An Owner always has one — signup
  /// asks for it — but an invite carries a name and an email and nothing else,
  /// so an invited account has no number until it chooses to add one. NULLs are
  /// distinct in a unique index, so any number of accounts may have none.
  phoneNumber      String?   @unique
  email            String?   @unique
  /// OPTIONAL for the same reason, and it carries the same meaning it does on
  /// Staff: NULL is "cannot log in yet", never "locked out". An invited
  /// Administrator has none until they follow their emailed link and choose a
  /// password. NEVER compare a supplied password against a NULL hash — treat
  /// NULL as no-login before any bcrypt call, which is what POST /auth/login does.
  passwordHash     String?
  name             String
  /// WAS a free-text String defaulting to "admin", written at signup and read by
  /// nothing. It is now the enum above, and OWNER is the default precisely so
  /// that every account that existed before this — all of which were the school
  /// signup account — keeps every power it had.
  role             AdminRole @default(OWNER)
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// The school this account OWNS. An array only because the relation is
  /// modelled from School.adminUserId; in practice it holds one row for an
  /// OWNER and none at all for an ADMINISTRATOR.
  School           School[]  @relation("SchoolOwner")
  /// The school this account is a MEMBER of, which is how an ADMINISTRATOR is
  /// scoped. Set on exactly the accounts School above is empty for. An OWNER
  /// leaves it NULL and is scoped by the school it owns instead — see
  /// loadAdminActor in src/auth.js, which accepts either and refuses a session
  /// that has neither rather than letting a query run unscoped.
  memberOfSchool   School?   @relation("SchoolAdmins", fields: [memberOfSchoolId], references: [id])
  memberOfSchoolId Int?

  passwordResetTokens PasswordResetToken[]

  /// Everything this account has created. Present so Prisma can express the
  /// other side of each createdBy; nothing reads these arrays — attribution is
  /// read off the record, from createdByName, not by walking back from here.
  createdStudents   Student[]          @relation("StudentCreatedBy")
  createdStaff      Staff[]            @relation("StaffCreatedBy")
  createdLedger     LedgerEntry[]      @relation("LedgerEntryCreatedBy")
  createdAttendance AttendanceRecord[] @relation("AttendanceRecordCreatedBy")
  createdWork       WorkRecord[]       @relation("WorkRecordCreatedBy")
  createdExpenses   Expense[]          @relation("ExpenseCreatedBy")

  /// Staff attendance submissions this account approved or rejected. Present so
  /// Prisma can express the other side of each relation; the screens read the
  /// decision off the submission, not by walking back from here.
  approvedStaffAttendance StaffAttendance[] @relation("StaffAttendanceApprovedBy")
  rejectedStaffAttendance StaffAttendance[] @relation("StaffAttendanceRejectedBy")

  /// The browsers this account has granted notification permission on. One row
  /// per DEVICE, not per account — see PushSubscription.
  pushSubscriptions PushSubscription[]

  @@index([memberOfSchoolId])
}

/// Who a platform account is on the INTERNAL team. Nothing to do with
/// AdminUser.role, which is a role inside one school — these two role systems
/// must never be compared or substituted for one another.
enum PlatformRole {
  /// May manage team accounts. The last remaining Founder cannot be deleted or
  /// demoted; that is enforced in src/routes/platform.js, not by hiding a button.
  FOUNDER
  /// Uses the console. Cannot see or reach the Administrators section at all.
  MEMBER
}

/// An internal team account. Deliberately a SEPARATE TABLE from AdminUser, not a
/// role on it: a platform session must never be loadable by the school session
/// path, and keeping the subjects in different tables means a token naming id 3
/// cannot resolve to a school admin just because the actorType claim was wrong.
///
/// There is no signup route for this table anywhere. Rows are created by the
/// untracked founder seed script, and thereafter by a Founder from the console.
model PlatformUser {
  id           Int          @id @default(autoincrement())
  name         String
  phoneNumber  String       @unique
  email        String       @unique
  passwordHash String
  role         PlatformRole @default(MEMBER)
  /// Disabling is preferred over deleting so the audit trail keeps pointing at a
  /// real row. A disabled account cannot authenticate.
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// Failed-login throttling, kept on the row rather than in memory: the API runs
  /// as serverless functions, so a per-process counter would reset on every cold
  /// start and protect nothing.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  auditEntries PlatformAuditLog[]
}

/// Every consequential thing a platform user does, written from the start rather
/// than added after something goes wrong. This table is append-only by
/// convention: no route updates or deletes a row.
model PlatformAuditLog {
  id         Int           @id @default(autoincrement())
  /// Null only for a failed login, where there may be no identifiable account.
  actorId    Int?
  actor      PlatformUser? @relation(fields: [actorId], references: [id])
  /// The email that was used, kept verbatim so a failed login against a
  /// non-existent account is still attributable to an attempt.
  actorEmail String?
  action     String
  /// What was acted on: "platform_user:4", "school:2", or null for a plain read.
  target     String?
  /// Small JSON blob of extra context. Never contains a password or a hash.
  detail     Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime      @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum OtpPurpose {
  /// The signup email check behind /school/verify-email. The only purpose any
  /// live code path writes or reads.
  SIGNUP_VERIFICATION
  /// Retained for the rows that already exist, NOT for new writes: password
  /// reset moved to PasswordResetToken and nothing issues one of these any more.
  /// Kept rather than dropped because a Postgres enum value cannot be removed
  /// while historical rows still reference it, and deleting those rows to tidy
  /// an enum is not a trade worth making.
  PASSWORD_RESET
}

model OtpCode {
  id                Int        @id @default(autoincrement())
  purpose           OtpPurpose
  identifier        String
  codeHash          String
  expiresAt         DateTime
  attemptsRemaining Int        @default(5)
  consumed          Boolean    @default(false)
  createdAt         DateTime   @default(now())

  @@index([identifier, purpose])
}

/// A single-use password reset link for a school admin.
///
/// A separate table from OtpCode rather than another OtpPurpose, because the two
/// are not the same kind of secret. An OTP is six digits a person retypes, so it
/// needs an attempt counter and a slow hash. This is 256 bits of CSPRNG output
/// that only ever travels inside a URL: nobody guesses it, so what it needs
/// instead is to be findable by its hash on the way back in, and to be spendable
/// exactly once.
model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, hex. The token itself is never stored — a leaked
  /// backup of this table must not hand anyone a working reset link. Unique
  /// because redemption looks a row up BY this value, and because two rows
  /// sharing one hash would make "which token was spent?" unanswerable.
  tokenHash String @unique

  expiresAt DateTime
  /// When the link was redeemed; null while it is still spendable. Set by a
  /// conditional update in src/routes/passwordReset.js, so two simultaneous
  /// redemptions of the same link race for one row and exactly one wins.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Requesting a reset supersedes that account's outstanding links, which is a
  /// delete by adminUserId.
  @@index([adminUserId])
}

// One outbound WhatsApp message to a guardian, written BEFORE the provider is
// called and updated afterwards with what came back.
//
// It exists for two reasons that pull in the same direction. The first is that a
// sent WhatsApp cannot be unsent: when a parent rings to ask why they were told
// their child was absent, the school needs a row saying which number was dialled
// on which date and what the provider said about it, and Twilio's own console is
// not something a school secretary is going to be given access to.
//
// The second is the duplicate guard below, which is the more load-bearing of the
// two.
model WhatsAppMessage {
  id                Int          @id @default(autoincrement())
  school            School       @relation(fields: [schoolId], references: [id])
  schoolId          Int
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         Int
  /// The guardian this actually went to, as opposed to whoever is on the
  /// student's record TODAY. Nullable because a Parent may be unlinked later
  /// (Student.parentId is ON DELETE SET NULL) and the log of what was sent must
  /// survive that -- a message history that rewrites itself when the guardian
  /// changes is not a history.
  parent            Parent?      @relation(fields: [parentId], references: [id], onDelete: SetNull)
  parentId          Int?
  /// Twilio's Content template identifier ("HX..."). Stored per row rather than
  /// read from config at display time because the template's WORDING can be
  /// edited in Twilio's console, and a row needs to say which version of the
  /// message this parent was actually sent.
  templateSid       String
  /// Why this was sent -- "absence" today. Part of the unique key below, so a
  /// later fee-reminder for the same student on the same day is a different
  /// message and is not blocked by an absence notice already sent.
  purpose           String
  /// The date the message is ABOUT (the register's date), not the date it was
  /// sent -- those differ whenever a register is chased up the next morning.
  /// Normalised to midnight UTC by startOfDayUTC(), the same normaliser
  /// AttendanceRecord.date goes through; without that the unique key below
  /// would key on a timestamp and admit a second notice per day.
  /// NULLABLE, AND NULL IS MEANINGFUL — it is what takes payment confirmations
  /// out of the day-based unique index below.
  ///
  /// For an absence notice or a fee reminder this is the day the message is
  /// ABOUT, and (studentId, purpose, referenceDate) is exactly the right guard:
  /// one notice per student per day per purpose.
  ///
  /// A payment confirmation is not a fact about a DAY, it is a fact about one
  /// PAYMENT, and a family may legitimately pay twice in a morning. Under a
  /// non-null date those two confirmations collide on that index and the second
  /// is refused — ordinary behaviour being blocked. Postgres treats NULLs as
  /// distinct in a unique index, so storing NULL here lets both through while
  /// leaving the index guarding the other two purposes exactly as before.
  ///
  /// Nothing is lost: the date a confirmation is about is the payment's own
  /// entryDate, on the LedgerEntry this row points at.
  referenceDate     DateTime?
  /// THE PAYMENT this confirmation is about. Null for every other purpose.
  ///
  /// SetNull rather than Cascade: the message really was sent, and deleting the
  /// payment afterwards must not erase the record that a parent was told about
  /// it. The snapshot below survives with it.
  ledgerEntry       LedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  ledgerEntryId     Int?
  /// WHAT THE MESSAGE ACTUALLY SAID, frozen at the moment it was sent.
  ///
  /// PATCH /ledger/:id can change a payment's amount after the fact. Without
  /// this, a parent could be holding a WhatsApp receipt for 15,000 FCFA against
  /// a ledger row that now reads 12,000, with nothing anywhere recording the
  /// discrepancy. These columns make it detectable by comparing them against
  /// the row as it stands today.
  ///
  /// Deliberately NOT kept in step with later edits, and nothing sends a
  /// correction. They are a record of what left this server.
  /// THE SUBMISSION this confirmation covers. One message per Pay Fees
  /// submission, however many category rows it created.
  paymentBatchId    String?
  sentReceiptNumber String?
  sentAmount        Int?
  sentBalance       Int?
  /// The number as it was DIALLED, post-normalisation, channel prefix and all
  /// ("whatsapp:+237679379134"). The stored Parent.phone is not enough: it can
  /// be edited afterwards, and the question this row has to answer is which
  /// digits the message actually went to.
  toNumber          String
  twilioSid         String?
  /// "queued" until the provider answers, then Twilio's own vocabulary --
  /// accepted, sending, sent, delivered, read, failed, undelivered. Kept as
  /// Twilio spells it rather than mapped to an enum of ours: a status we have
  /// not seen before should show up verbatim in the log rather than being
  /// flattened into an "unknown" that hides it.
  ///
  /// "failed_to_send" is the one value of ours, for the case where the HTTP call
  /// itself never got an answer -- no Twilio status exists for a request Twilio
  /// never received.
  status            String       @default("queued")
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  /// THE DUPLICATE GUARD, and it lives here rather than in a check in the route
  /// on purpose.
  ///
  /// Two admins on the attendance screen at the same time -- or one admin who
  /// double-clicks Send, or a request the browser retried after a timeout --
  /// both read "not sent yet", both pass an application-level check, and both
  /// send. A parent then gets told twice that their child was absent, which
  /// reads as the school being confused about their child. An index is the only
  /// version of this rule that two concurrent requests cannot both satisfy.
  ///
  /// The route relies on that: it CREATES the row first and treats a P2002 as
  /// "already sent", so the row is claimed before the provider is called and the
  /// loser of the race never reaches Twilio at all.
  @@unique([studentId, purpose, referenceDate])
  /// ONE CONFIRMATION PER PAYMENT, enforced by the database rather than by a
  /// check in the route — two clicks in the same second are the case it exists
  /// for.
  ///
  /// Keyed on the payment, not the day, so two payments from one family in one
  /// morning are two confirmations. Purpose is in the key so a future message
  /// type could reference a payment without colliding with this one, and
  /// ledgerEntryId is NULL for every other purpose — NULLs being distinct, this
  /// index constrains nothing else.
  @@unique([ledgerEntryId, purpose])
  /// ONE CONFIRMATION PER SUBMISSION. The real guard now: a message covers a
  /// whole batch, so keying only on a row would leave the other rows of that
  /// batch looking unconfirmed.
  ///
  /// The row-level index above is KEPT rather than replaced. It costs nothing,
  /// ledgerEntryId still answers "which row did this message name", and a
  /// retry updates the existing row rather than inserting, so neither index
  /// stands in its way. Both are NULL for every other purpose.
  @@unique([paymentBatchId, purpose])
  @@index([ledgerEntryId])
  @@index([paymentBatchId])
  @@index([schoolId, referenceDate])
  @@index([twilioSid])
}

/// THE RECEIPT SEQUENCE for one school. ONE ROW PER SCHOOL, FOR THE LIFE OF THE
/// SCHOOL.
///
/// IT NEVER RESETS, and that is the whole reason it is keyed the way it is.
/// This used to be one row per (school, academic year), because the number it
/// fed had the year in it — "2026/2027-0042" — so restarting at 1 each year was
/// safe: the year told the two apart. Receipt numbers are now "CNPS042", with
/// no year anywhere in them. Reset that counter each September and this year's
/// CNPS001 is character-for-character last year's CNPS001, on two different
/// payments, and nothing on the receipt or in the search can separate them.
///
/// So the academicYear column is gone rather than merely ignored. A column that
/// still existed would eventually be keyed on again by someone reasonably
/// assuming it meant something.
///
/// A COUNTER ROW, DELIBERATELY NOT A POSTGRES SEQUENCE. A sequence does not roll
/// back: an aborted payment transaction would consume a number permanently and
/// leave a gap indistinguishable from a receipt that was issued and later
/// retired. A row incremented inside the same transaction as the payment insert
/// rolls back with it, so the only gaps in the numbering are the intentional
/// ones — which is what makes a gap evidence rather than noise.
///
/// This SERIALISES concurrent payment inserts within one school: the ON CONFLICT
/// DO UPDATE that increments it takes a row lock held to the end of the
/// transaction, so a second cashier's insert waits. At school volumes — tens of
/// payments a day, not thousands a second — that is both correct and cheap, and
/// it is the property that makes the numbering gapless. It is not an oversight
/// and must not be "optimised" into a sequence or a read-then-write. See
/// src/utils/receiptNumber.js.
///
/// NOT REWOUND, EVER. A deleted payment retires its number into
/// RetiredReceiptNumber and leaves a gap; rewinding to close the gap would
/// reissue a number that is already printed on a parent's receipt, and a
/// duplicate is far worse than a gap. Do not "clean this up".
model ReceiptCounter {
  id           Int      @id @default(autoincrement())
  school       School   @relation(fields: [schoolId], references: [id])
  schoolId     Int
  /// The last number issued. The next payment gets this plus one.
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// ON THE SCHOOL ALONE. This is the index the ON CONFLICT in
  /// issueReceiptNumber targets, and the reason one school can only ever have
  /// one live sequence.
  @@unique([schoolId])
}

/// ONE ROW PER RECEIPT NUMBER EVER ISSUED. The register of what has been handed
/// out.
///
/// WHY THIS TABLE EXISTS. A receipt number used to identify a LedgerEntry row,
/// and `@@unique([schoolId, receiptNumber])` on that table was the whole guard:
/// two cashiers in the same second could not produce the same number because
/// the database would refuse the second insert.
///
/// A number now identifies a SUBMISSION. Paying seven fees in one hand-over of
/// money is one payment with one number, written onto all seven rows — so the
/// number legitimately repeats down LedgerEntry.receiptNumber, and that index
/// had to go. Nothing on LedgerEntry can express "no two submissions share a
/// number" once the column repeats within a submission; a unique index cannot
/// state a rule about the DISTINCT values of another column.
///
/// So the guarantee moved here rather than being downgraded to a convention.
/// One row is written per allocation, inside the same transaction that
/// increments the counter and inserts the payment — so it rolls back with them,
/// and a released number leaves no row behind.
///
/// THE TWO INDEXES ARE THE ENTIRE POINT, and they are not redundant:
///   - (schoolId, receiptNumber) — no two submissions in a school share a
///     number. This is the old LedgerEntry guard, relocated intact.
///   - (schoolId, paymentBatchId) — no submission is given two numbers. New,
///     and it is what makes "one receipt per submission" a fact the database
///     holds rather than a property of the write path being correct.
///
/// paymentBatchId IS NULLABLE, for history only. Every number issued from now
/// on has a batch. The rows backfilled when this table was created do not always
/// have one: 95 payments predate batching entirely, and three older submissions
/// were issued SEVERAL numbers each — the exact artefact this change exists to
/// end. Those cannot be described under the new rule without inventing a batch
/// that never existed, so their registry rows record the number and leave the
/// batch null. NULLs being distinct in Postgres, they coexist under the unique
/// index without weakening it for anything issued since.
model ReceiptIssue {
  id             Int      @id @default(autoincrement())
  school         School   @relation(fields: [schoolId], references: [id])
  schoolId       Int
  receiptNumber  String
  /// Null only for the historical rows described above.
  paymentBatchId String?
  issuedAt       DateTime @default(now())

  @@unique([schoolId, receiptNumber])
  @@unique([schoolId, paymentBatchId])
}

/// A receipt number whose payment no longer exists.
///
/// Payments are HARD DELETED — there is no void and no status column — so
/// without this row the deletion of a numbered payment would leave a gap in the
/// sequence with nothing anywhere to explain it. A gap is meant to be evidence;
/// an unexplained one is just a number nobody can account for, which is worse
/// than no numbering at all.
///
/// The number is NEVER reissued. This table is the record that it was used, and
/// the counter it came from is not rewound.
///
/// DELIBERATELY DENORMALISED. studentId is a plain column with no foreign key,
/// and the student's name and the amount are copied in as text and integer,
/// because the whole point is to outlive the rows it describes — a student
/// deleted later cascades away their ledger entries, and a FK here would take
/// the evidence with them.
model RetiredReceiptNumber {
  id               Int      @id @default(autoincrement())
  school           School   @relation(fields: [schoolId], references: [id])
  schoolId         Int
  receiptNumber    String
  academicYear     String
  /// What the payment said, kept as plain values for the reasons above.
  studentId        Int?
  studentName      String?
  amount           Int
  entryDate        DateTime
  /// Who retired it and when. The deletion route is owner-only.
  retiredAt        DateTime @default(now())
  retiredByAdminId Int?
  retiredByName    String?
  /// 'deleted' today. A soft void, if it is ever built, would be another value
  /// here rather than another table.
  reason           String   @default("deleted")

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, academicYear])
}

/// THE REMINDER WORDING, in the database rather than in code.
///
/// Every reminder the product sends reads its title and body from HERE at send
/// time. That is the entire reason the table exists: the team edits the words in
/// the console and the very next send uses them, with no deploy in between.
///
/// Which imposes one rule on everything that sends: nothing may hardcode a
/// title or a body. A cron job that phrased its own message would leave these
/// rows describing what the system USED to say, and the console would be a
/// screen that appears to work and changes nothing.
///
/// PLACEHOLDERS. Bodies may contain [N] and [date], substituted at send time
/// from values the caller computes — see substitute() in
/// src/utils/pushNotification.js. They are stored literally, so the console
/// shows the team exactly what the code will look for.
model ReminderConfig {
  id Int @id @default(autoincrement())

  /// The stable identifier the code joins on ("incomplete_setup"). NEVER edited
  /// and never displayed raw — the console edits title, body and enabled, and
  /// renders this as a readable label. Unique because a second row for a key
  /// would make "which wording is current?" a question with two answers.
  key String @unique

  title String
  body  String

  /// The TEAM's switch, and global across every school. Distinct from
  /// School.notificationsEnabled, which is one school silencing everything for
  /// itself. Neither implies the other, so both are consulted on every send.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ONE ROW PER BROWSER THAT HAS GRANTED NOTIFICATION PERMISSION — a DEVICE, not
/// a person. An admin with a laptop and a phone has two rows.
///
/// endpoint is the push service's own address for exactly one browser, which is
/// what makes it the natural key: two rows sharing one would send the same
/// notification twice to the same screen. Re-subscribing after a browser
/// rotates its keys therefore UPSERTS on endpoint rather than inserting.
///
/// adminUserId and staffId are both nullable and exactly one is set. This table
/// serves two unrelated account tables — AdminUser and Staff — and there is no
/// shared user row to point at. The database cannot express "exactly one of
/// these", so POST /push/subscribe is what guarantees it: it derives the owner
/// from the session rather than accepting one from the client.
///
/// schoolId is stored here rather than walked to through whichever owner is
/// set, because School.notificationsEnabled is checked on EVERY send. The
/// denormalisation turns "may I send to this device?" into one indexed read.
model PushSubscription {
  id Int @id @default(autoincrement())

  /// ON DELETE CASCADE on both owners: a deleted account's devices must not
  /// outlive it. A stale row would still be found by sendPushToSchool and
  /// pushed to a browser whose owner no longer has an account.
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId Int?
  staff       Staff?     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId     Int?

  /// RESTRICT, matching every other school FK in this schema. Deleting a school
  /// has its own deliberate teardown in the platform console.
  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  /// The three lookups this table actually serves: every device in a school,
  /// and every device belonging to one person (both send paths, and unsubscribe).
  @@index([schoolId])
  @@index([adminUserId])
  @@index([staffId])
}
